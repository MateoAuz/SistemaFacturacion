@page "/clientes"
@rendermode InteractiveServer
@using SistemaFacturacion.Domain.Entities
@using System.ComponentModel.DataAnnotations 
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-people-fill"></i> Gestión de Clientes</h1>
    <p class="mb-0 mt-2 opacity-75">Administra la información de tus clientes</p>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <!-- Pestañas -->
    <div class="mb-4">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link @(tabActiva == "activos" ? "active" : "")" @onclick='() => CambiarTab("activos")'>
                    <i class="bi bi-person-check"></i> Clientes Activos
                    <span class="badge bg-primary ms-1">@clientesActivos.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tabActiva == "inactivos" ? "active" : "")"
                    @onclick='() => CambiarTab("inactivos")'>
                    <i class="bi bi-person-x"></i> Clientes Inactivos
                    <span class="badge bg-secondary ms-1">@clientesInactivos.Count</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="mb-4">
        @if (tabActiva == "activos")
        {
            <button class="btn btn-primary btn-modern" @onclick="ToggleForm">
                <i class="bi bi-@(mostrandoForm ? "x-circle" : "plus-circle")"></i>
                @(mostrandoForm ? "Cancelar" : "Nuevo Cliente")
            </button>
        }
    </div>

    @if (mostrandoForm)
    {
        <div class="card-modern">
            <h5 class="mb-3"><i class="bi bi-person-plus"></i> Nuevo Cliente</h5>
            
            <EditForm Model="nuevoCliente" OnValidSubmit="Guardar" Context="formContext">
                <DataAnnotationsValidator />
                
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger alert-modern">
                        <i class="bi bi-exclamation-triangle"></i> @mensajeError
                    </div>
                }

                <div class="row g-3">
                    <!-- Tipo Identificación -->
                    <div class="col-md-2">
                        <label class="form-label">Tipo ID *</label>
                        <InputSelect class="form-select" @bind-Value="nuevoCliente.TipoIdentificacion">
                            <option value="">Seleccione...</option>
                            <option value="CEDUL">Cédula</option>
                            <option value="RUC">RUC</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => nuevoCliente.TipoIdentificacion)" class="text-danger small" />
                    </div>

                    <!-- Identificación -->
                    <div class="col-md-4">
                        <label class="form-label">Identificación *</label>
                        <InputText class="form-control" @bind-Value="nuevoCliente.Identificacion" 
                                  placeholder="0123456789" maxlength="13" />
                        <ValidationMessage For="@(() => nuevoCliente.Identificacion)" class="text-danger small" />
                        @if (!string.IsNullOrEmpty(mensajeValidacionCedula))
                        {
                            <div class="text-danger small">@mensajeValidacionCedula</div>
                        }
                    </div>

                    <!-- Nombres -->
                    <div class="col-md-3">
                        <label class="form-label">Nombres *</label>
                        <InputText class="form-control" @bind-Value="nuevoCliente.Nombres" 
                                  placeholder="Juan Carlos" maxlength="60" />
                        <ValidationMessage For="@(() => nuevoCliente.Nombres)" class="text-danger small" />
                    </div>

                    <!-- Apellidos -->
                    <div class="col-md-3">
                        <label class="form-label">Apellidos</label>
                        <InputText class="form-control" @bind-Value="nuevoCliente.Apellidos" 
                                  placeholder="Pérez López" maxlength="60" />
                        <ValidationMessage For="@(() => nuevoCliente.Apellidos)" class="text-danger small" />
                    </div>

                    <!-- Correo -->
                    <div class="col-md-5">
                        <label class="form-label">Correo</label>
                        <InputText class="form-control" @bind-Value="nuevoCliente.Correo" 
                                  placeholder="ejemplo@correo.com" type="email" maxlength="80" />
                        <ValidationMessage For="@(() => nuevoCliente.Correo)" class="text-danger small" />
                    </div>

                    <!-- Teléfono -->
                    <div class="col-md-3">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="nuevoCliente.Telefono" 
                                  placeholder="0999999999" maxlength="15" />
                        <ValidationMessage For="@(() => nuevoCliente.Telefono)" class="text-danger small" />
                    </div>

                    <!-- Dirección -->
                    <div class="col-md-4">
                        <label class="form-label">Dirección</label>
                        <InputText class="form-control" @bind-Value="nuevoCliente.Direccion"
                                placeholder="Calle 123 y Av. Principal" maxlength="120" />
                        <ValidationMessage For="@(() => nuevoCliente.Direccion)" class="text-danger small" />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success btn-modern" disabled="@guardando">
                        <i class="bi bi-check-circle"></i> 
                        @(guardando ? "Guardando..." : "Guardar Cliente")
                    </button>
                </div>
            </EditForm>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-info alert-modern mt-3">
                    <i class="bi bi-info-circle"></i> @mensaje
                </div>
            }
        </div>
    }

    <!-- El resto del código de la tabla permanece igual -->
    <div class="table-modern">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-card-heading"></i> Tipo</th>
                    <th><i class="bi bi-hash"></i> Identificación</th>
                    <th><i class="bi bi-person"></i> Nombre Completo</th>
                    <th><i class="bi bi-envelope"></i> Correo</th>
                    <th><i class="bi bi-telephone"></i> Teléfono</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (clientesActuales.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-2">
                                @(tabActiva == "activos" ? "No hay clientes activos" : "No hay clientes inactivos")
                            </p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var c in clientesActuales)
                    {
                        <tr>
                            <td><span class="badge bg-primary badge-custom">@c.TipoIdentificacion</span></td>
                            <td>@c.Identificacion</td>
                            <td><strong>@c.Nombres @c.Apellidos</strong></td>
                            <td>@c.Correo</td>
                            <td>@c.Telefono</td>
                            <td class="text-end">
                                @if (tabActiva == "activos")
                                {
                                    <button class="btn btn-sm btn-info btn-modern me-2" @onclick="() => Editar(c.IdCliente)"
                                        title="Editar cliente">
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>

                                    <button class="btn btn-sm btn-warning btn-modern" @onclick="() => Desactivar(c.IdCliente)"
                                        title="Desactivar cliente">
                                        <i class="bi bi-person-dash"></i> Desactivar
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-success btn-modern" @onclick="() => Reactivar(c.IdCliente)"
                                        title="Reactivar cliente">
                                        <i class="bi bi-person-check"></i> Reactivar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool isLoading = true;
    private bool mostrandoForm = false;
    private bool guardando = false;
    private string tabActiva = "activos";
    private List<Cliente> clientesActivos = new();
    private List<Cliente> clientesInactivos = new();
    private Cliente nuevoCliente = new();
    private string? mensaje;
    private string? mensajeError;
    private string? mensajeValidacionCedula;

    private List<Cliente> clientesActuales => tabActiva == "activos" ? clientesActivos : clientesInactivos;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        isLoading = true;
        mensaje = null;
        mensajeError = null;
        try
        {
            // Cargar clientes activos
            var urlActivos = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes";
            clientesActivos = await Http.GetFromJsonAsync<List<Cliente>>(urlActivos) ?? new();

            // Cargar clientes inactivos
            var urlInactivos = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes/inactivos";
            clientesInactivos = await Http.GetFromJsonAsync<List<Cliente>>(urlInactivos) ?? new();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar clientes: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleForm()
    {
        mostrandoForm = !mostrandoForm;
        if (mostrandoForm)
        {
            nuevoCliente = new Cliente { Estado = true };
            LimpiarMensajes();
        }
    }

    private async Task Guardar()
    {
        guardando = true;
        LimpiarMensajes();

        try
        {
            // Validación personalizada de cédula/RUC
            var errorValidacion = nuevoCliente.ValidarIdentificacion();
            if (!string.IsNullOrEmpty(errorValidacion))
            {
                mensajeValidacionCedula = errorValidacion;
                guardando = false;
                return;
            }

            // Validar si la identificación ya existe
            var urlVerificar = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes/existe/{nuevoCliente.Identificacion}";
            var responseVerificar = await Http.GetAsync(urlVerificar);
            
            if (responseVerificar.IsSuccessStatusCode)
            {
                var existe = await responseVerificar.Content.ReadFromJsonAsync<bool>();
                if (existe)
                {
                    mensajeError = "Ya existe un cliente con esta identificación";
                    guardando = false;
                    return;
                }
            }

            // Guardar el cliente
            var urlGuardar = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes";
            var response = await Http.PostAsJsonAsync(urlGuardar, nuevoCliente);

            if (response.IsSuccessStatusCode)
            {
                mensaje = "✅ Cliente guardado exitosamente";
                mostrandoForm = false;
                await CargarClientes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensajeError = $"Error al guardar: {error}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void LimpiarMensajes()
    {
        mensaje = null;
        mensajeError = null;
        mensajeValidacionCedula = null;
    }

    private void CambiarTab(string tab)
    {
        tabActiva = tab;
        mostrandoForm = false;
        LimpiarMensajes();
    }

    private async Task Desactivar(int id)
    {
        LimpiarMensajes();
        try
        {
            var url = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes/{id}";
            var response = await Http.DeleteAsync(url);

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                mensaje = "Cliente desactivado correctamente";
                await CargarClientes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensajeError = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
    }

    private async Task Reactivar(int id)
    {
        LimpiarMensajes();
        try
        {
            var url = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes/{id}/reactivar";
            var response = await Http.PatchAsync(url, null);

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                mensaje = "Cliente reactivado correctamente";
                await CargarClientes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensajeError = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
    }

    private void Editar(int id)
    {
        Console.WriteLine($"Navegando a editar cliente ID: {id}");
        Nav.NavigateTo($"/editar-cliente/{id}");
    }
}