@page "/clientes"

@rendermode InteractiveServer
@using SistemaFacturacion.Domain.Entities

@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-people-fill"></i> Gestión de Clientes</h1>
    <p class="mb-0 mt-2 opacity-75">Administra la información de tus clientes</p>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <!-- Pestañas -->
    <div class="mb-4">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link @(tabActiva == "activos" ? "active" : "")" @onclick='() => CambiarTab("activos")'>
                    <i class="bi bi-person-check"></i> Clientes Activos
                    <span class="badge bg-primary ms-1">@clientesActivos.Count</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tabActiva == "inactivos" ? "active" : "")"
                    @onclick='() => CambiarTab("inactivos")'>
                    <i class="bi bi-person-x"></i> Clientes Inactivos
                    <span class="badge bg-secondary ms-1">@clientesInactivos.Count</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="mb-4">
        @if (tabActiva == "activos")
        {
            <button class="btn btn-primary btn-modern" @onclick="ToggleForm">
                <i class="bi bi-@(mostrandoForm ? "x-circle" : "plus-circle")"></i>
                @(mostrandoForm ? "Cancelar" : "Nuevo Cliente")
            </button>
        }
    </div>

    @if (mostrandoForm)
    {
        <div class="card-modern">
            <h5 class="mb-3"><i class="bi bi-person-plus"></i> Nuevo Cliente</h5>
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Tipo ID</label>
                    <select class="form-select" @bind="nuevoCliente.TipoIdentificacion">
                        <option value="">Seleccione...</option>
                        <option value="CEDUL">Cédula</option>
                        <option value="RUC">RUC</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Identificación</label>
                    <input type="text" class="form-control" @bind="nuevoCliente.Identificacion" placeholder="0123456789" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nombres</label>
                    <input type="text" class="form-control" @bind="nuevoCliente.Nombres" placeholder="Juan Carlos" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Apellidos</label>
                    <input type="text" class="form-control" @bind="nuevoCliente.Apellidos" placeholder="Pérez López" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Correo</label>
                    <input type="email" class="form-control" @bind="nuevoCliente.Correo" placeholder="ejemplo@correo.com" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <input type="text" class="form-control" @bind="nuevoCliente.Telefono" placeholder="0999999999" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Dirección</label>
                    <input type="text" class="form-control" @bind="nuevoCliente.Direccion"
                        placeholder="Calle 123 y Av. Principal" />
                </div>
            </div>
            <div class="mt-4">
                <button class="btn btn-success btn-modern" @onclick="Guardar">
                    <i class="bi bi-check-circle"></i> Guardar Cliente
                </button>
            </div>
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-info alert-modern mt-3">
                    <i class="bi bi-info-circle"></i> @mensaje
                </div>
            }
        </div>
    }

    <div class="table-modern">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-card-heading"></i> Tipo</th>
                    <th><i class="bi bi-hash"></i> Identificación</th>
                    <th><i class="bi bi-person"></i> Nombre Completo</th>
                    <th><i class="bi bi-envelope"></i> Correo</th>
                    <th><i class="bi bi-telephone"></i> Teléfono</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (clientesActuales.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-2">
                                @(tabActiva == "activos" ? "No hay clientes activos" : "No hay clientes inactivos")
                            </p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var c in clientesActuales)
                    {
                        <tr>
                            <td><span class="badge bg-primary badge-custom">@c.TipoIdentificacion</span></td>
                            <td>@c.Identificacion</td>
                            <td><strong>@c.Nombres @c.Apellidos</strong></td>
                            <td>@c.Correo</td>
                            <td>@c.Telefono</td>
                            <td class="text-end">
                                @if (tabActiva == "activos")
                                {
                                    <button class="btn btn-sm btn-info btn-modern me-2" @onclick="() => Editar(c.IdCliente)"
                                        title="Editar cliente">
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>

                                    <button class="btn btn-sm btn-warning btn-modern" @onclick="() => Desactivar(c.IdCliente)"
                                        title="Desactivar cliente">
                                        <i class="bi bi-person-dash"></i> Desactivar
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-success btn-modern" @onclick="() => Reactivar(c.IdCliente)"
                                        title="Reactivar cliente">
                                        <i class="bi bi-person-check"></i> Reactivar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool isLoading = true;
    private bool mostrandoForm = false;
    private string tabActiva = "activos";
    private List<Cliente> clientesActivos = new();
    private List<Cliente> clientesInactivos = new();
    private Cliente nuevoCliente = new();
    private string? mensaje;

    private List<Cliente> clientesActuales => tabActiva == "activos" ? clientesActivos : clientesInactivos;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        isLoading = true;
        mensaje = null;
        try
        {
            // Cargar clientes activos
            var urlActivos = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes";
            clientesActivos = await Http.GetFromJsonAsync<List<Cliente>>(urlActivos) ?? new();

            // Cargar clientes inactivos
            var urlInactivos = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes/inactivos";
            clientesInactivos = await Http.GetFromJsonAsync<List<Cliente>>(urlInactivos) ?? new();
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleForm()
    {
        mostrandoForm = !mostrandoForm;
        if (mostrandoForm)
        {
            nuevoCliente = new Cliente { Estado = true };
        }
        mensaje = null;
    }

    private async Task Guardar()
    {
        mensaje = null;

        if (string.IsNullOrWhiteSpace(nuevoCliente.TipoIdentificacion) ||
        string.IsNullOrWhiteSpace(nuevoCliente.Identificacion) ||
        string.IsNullOrWhiteSpace(nuevoCliente.Nombres))
        {
            mensaje = "Complete Tipo, Identificación y Nombres";
            return;
        }

        try
        {
            var url = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes";
            var response = await Http.PostAsJsonAsync(url, nuevoCliente);

            if (response.IsSuccessStatusCode)
            {
                mensaje = "Cliente guardado exitosamente";
                mostrandoForm = false;
                await CargarClientes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"Error {(int)response.StatusCode}: {error}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Excepción: {ex.Message}";
        }
    }

    private void CambiarTab(string tab)
    {
        tabActiva = tab;
        mostrandoForm = false;
    }

    private async Task Desactivar(int id)
    {
        mensaje = null;
        try
        {
            var url = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes/{id}";
            var response = await Http.DeleteAsync(url);

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                mensaje = "Cliente desactivado correctamente";
                await CargarClientes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Excepción: {ex.Message}";
        }
    }

    private async Task Reactivar(int id)
    {
        mensaje = null;
        try
        {
            var url = $"{Nav.BaseUri.TrimEnd('/')}/api/clientes/{id}/reactivar";
            var response = await Http.PatchAsync(url, null);

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                mensaje = "Cliente reactivado correctamente";
                await CargarClientes();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensaje = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Excepción: {ex.Message}";
        }
    }

    private void Editar(int id)
{
    Console.WriteLine($"Navegando a editar cliente ID: {id}");
    Nav.NavigateTo($"/editar-cliente/{id}");
}
}