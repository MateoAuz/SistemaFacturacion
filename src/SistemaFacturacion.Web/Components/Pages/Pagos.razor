@page "/pagos"
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using SistemaFacturacion.Domain.Entities

<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-file-earmark-bar-graph"></i> Pagos de Facturas</h1>
</div>

<div class="card card-modern">
    <div class="card-header">
        <h4 class="mb-0">Facturas</h4>
    </div>

    <div class="card-body">
        <div class="tabs-container d-flex flex-wrap align-items-center mb-3">
            @foreach (var estado in FacturaEstados)
            {
                <button class="tab-btn @(filtroEstado == estado.Key ? "active" : "") me-2 mb-1" 
                        @onclick="() => AplicarFiltro(estado.Key)">
                    <i class="bi @estado.Value.Icon"></i> @estado.Value.Label
                    <span class="badge-count">@GetFacturaCountByState(estado.Key)</span>
                </button>
            }
        </div>

        @if (cargando)
        {
            <div class="alert-info-custom fade-in">
                <i class="bi bi-arrow-clockwise"></i> Cargando facturas...
            </div>
        }
        else if (!facturasFiltradas.Any())
        {
            <div class="alert-info-custom fade-in">
                <i class="bi bi-inbox"></i> No hay facturas registradas @(filtroEstado != "TODAS" ? $"con estado '{FacturaEstados.GetValueOrDefault(filtroEstado).Label}'." : ".")
            </div>
        }
        else
        {
            <div class="table-responsive fade-in">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>N° Factura</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in facturasFiltradas)
                        {
                            <tr>
                                <td>@f.NumeroFactura</td>
                                <td>@($"{f.Cliente?.Nombres} {f.Cliente?.Apellidos}")</td>
                                <td>@f.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end fw-bold text-primary">$@f.Total.ToString("N2")</td> 
                                <td class="text-center">
                                    <span class="badge @GetEstadoBadgeClass(f.Estado)">
                                        @FacturaEstados.GetValueOrDefault(f.Estado).Label
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-sm btn-info" @onclick="() => VerFactura(f)">
                                            <i class="bi bi-eye"></i> Ver Detalle
                                        </button>
                                        @if (f.Estado == "PENDIENTE" && f.SaldoPendiente > 0)
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => AbrirModalPago(f)">
                                                <i class="bi bi-cash-coin"></i> Pagar
                                            </button>
                                        }
                                        
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Modal de Detalle de Factura *@
@if (facturaSeleccionada is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content p-3" style="border-radius: 10px;">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-primary">
                        <i class="bi bi-file-earmark-text"></i> Factura N° @facturaSeleccionada.NumeroFactura
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body">
                    <div class="row mb-3 border-bottom pb-3">
                        <div class="col-6">
                            <h6 class="fw-bold text-secondary">Cliente</h6>
                            <p class="mb-1">@facturaSeleccionada.Cliente?.Nombres @facturaSeleccionada.Cliente?.Apellidos</p>
                            <p class="mb-1 small text-muted"><strong>Identificación:</strong> @facturaSeleccionada.Cliente?.Identificacion</p>
                            <p class="mb-1 small text-muted"><strong>Correo:</strong> @facturaSeleccionada.Cliente?.Correo</p>
                        </div>
                        <div class="col-6 text-end">
                            <h6 class="fw-bold text-secondary">Resumen</h6>
                            <span class="badge @GetEstadoBadgeClass(facturaSeleccionada.Estado)">
                                @FacturaEstados.GetValueOrDefault(facturaSeleccionada.Estado).Label
                            </span>
                            <p class="mt-2 mb-1 small text-muted"><strong>Emisión:</strong> @facturaSeleccionada.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="fw-bold fs-5 mt-2 @GetSaldoClass(facturaSeleccionada.SaldoPendiente)">
                                Saldo Pendiente: $@facturaSeleccionada.SaldoPendiente.ToString("N2")
                            </p>
                        </div>
                    </div>
                    
                    <h6 class="fw-bold text-secondary mt-3">Detalle de Productos</h6>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th class="text-end">P. Unitario</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (facturaSeleccionada.Detalles is not null && facturaSeleccionada.Detalles.Any())
                            {
                                @foreach (var d in facturaSeleccionada.Detalles)
                                {
                                    <tr>
                                        <td>@d.NombreProducto</td>
                                        <td class="text-center">@d.Cantidad</td>
                                        <td class="text-end">$@d.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end">$@d.TotalLinea.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No hay detalles disponibles.</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">SUBTOTAL:</td>
                                <td class="text-end fw-bold">$@facturaSeleccionada.Subtotal.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">IVA:</td>
                                <td class="text-end fw-bold">$@facturaSeleccionada.Iva.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end fw-bold fs-5">TOTAL:</td>
                                <td class="text-end fw-bold fs-5 text-primary">$@facturaSeleccionada.Total.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>
                    @if (facturaSeleccionada.Estado == "PENDIENTE" && facturaSeleccionada.SaldoPendiente > 0)
                    {
                        <button class="btn btn-success" @onclick="() => AbrirModalPago(facturaSeleccionada)">
                            <i class="bi bi-cash-coin"></i> Registrar Pago
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* Modal de Registro de Pagos (CA-06.1 - CA-06.4) *@
@if (mostrarModalPago)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content p-3" style="border-radius: 10px;">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-success">
                        <i class="bi bi-cash-coin"></i> Registrar Pago - Factura N° @facturaParaPago?.NumeroFactura
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalPago"></button>
                </div>
                <EditForm Model="pagoForm" OnValidSubmit="RegistrarPago" FormName="registro-pago">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensajePagoError))
                        {
                            <div class="alert alert-danger alert-modern"><i class="bi bi-exclamation-triangle"></i> @mensajePagoError</div>
                        }

                        <p class="alert alert-info alert-modern fw-bold">
                            Saldo Pendiente: $@facturaParaPago?.SaldoPendiente.ToString("N2")
                        </p>

                        <div class="mb-3">
                            <label class="form-label">Monto a Pagar *</label>
                            <input type="text" class="form-control fw-bold fs-5 text-success" 
                                value="$@facturaParaPago?.SaldoPendiente.ToString("N2")" 
                                readonly 
                                style="background-color: #e9ecef; cursor: not-allowed;" />
                            <small class="text-muted">El pago debe ser por el monto total pendiente.</small>
                            <ValidationMessage For="@(() => pagoForm.Monto)" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Método de Pago *</label>
                            <InputSelect class="form-select" @bind-Value="pagoForm.MetodoPago">
                                <option value="">Seleccione un método</option>
                                @foreach (var metodo in MetodosPago)
                                {
                                    <option value="@metodo">@metodo</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => pagoForm.MetodoPago)" />
                        </div>
                    </div>

                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalPago" disabled="@guardandoPago">Cancelar</button>
                        <button type="submit" class="btn btn-success" disabled="@guardandoPago">
                             @if (guardandoPago)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-check-circle"></i> Registrar Pago
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@code {
    private bool cargando = true;
    private string filtroEstado = "TODAS";
    private List<FacturaDto> facturas = new();
    private List<FacturaDto> facturasFiltradas => filtroEstado == "TODAS"
        ? facturas
        : facturas.Where(f => f.Estado == filtroEstado).ToList();

    // Factura Detail Modal
    private FacturaDto? facturaSeleccionada;
    private List<PagoDto> pagosFactura = new();

    // Pago Modal
    private bool mostrarModalPago = false;
    private FacturaDto? facturaParaPago;
    private PagoRequestDto pagoForm = new();
    private bool guardandoPago = false;
    private string? mensajePagoError;

    // Constantes para UI
    private List<string> MetodosPago = new() { "Efectivo", "Transferencia bancaria", "Tarjeta de débito" };
    private Dictionary<string, (string Label, string Icon)> FacturaEstados = new()
    {
        {"TODAS", ("Todas", "bi-journals")},
        {"PENDIENTE", ("Pendiente", "bi-clock")},
        {"PAGADA", ("Pagada", "bi-check-circle")},
    };
    
    protected override async Task OnInitializedAsync()
    {
        await CargarFacturas();
    }

    private async Task CargarFacturas()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            var url = $"api/facturas";
            var data = await Http.GetFromJsonAsync<List<FacturaDto>>(url);
            facturas = data ?? new List<FacturaDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar facturas: {ex.Message}");
            facturas = new List<FacturaDto>();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarPagos(int idFactura)
    {
        try
        {
            pagosFactura = await Http.GetFromJsonAsync<List<PagoDto>>($"api/pagos/by-factura/{idFactura}") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar pagos: {ex.Message}");
            pagosFactura = new List<PagoDto>();
        }
    }

    private async Task VerFactura(FacturaDto factura)
    {
        facturaSeleccionada = factura;
        await CargarPagos(factura.IdFactura);
    }

    private void CerrarModal()
    {
        facturaSeleccionada = null;
    }
    
    private void AplicarFiltro(string estado)
    {
        filtroEstado = estado;
        StateHasChanged();
    }

    private int GetFacturaCountByState(string estado)
    {
        if (estado == "TODAS") return facturas.Count;
        return facturas.Count(f => f.Estado == estado);
    }

    // --- Lógica de Pagos (CA-06.1 - CA-06.4) ---
    private void AbrirModalPago(FacturaDto factura)
    {
        facturaParaPago = factura;
        pagoForm = new PagoRequestDto { IdFactura = factura.IdFactura, Monto = factura.SaldoPendiente, MetodoPago = "Efectivo" };
        mensajePagoError = null;
        mostrarModalPago = true;
        CerrarModal(); 
        StateHasChanged();
    }
    
    private void CerrarModalPago()
    {
        mostrarModalPago = false;
        facturaParaPago = null;
        mensajePagoError = null;
    }
    
    private async Task RegistrarPago()
    {
        guardandoPago = true;
        mensajePagoError = null;

        try
        {
            if (pagoForm.Monto <= 0)
            {
                mensajePagoError = "El monto debe ser mayor a cero.";
                return;
            }
            if (pagoForm.Monto > facturaParaPago?.SaldoPendiente)
            {
                mensajePagoError = $"El pago excede el saldo pendiente ({facturaParaPago.SaldoPendiente:N2}).";
                return;
            }

            var response = await Http.PostAsJsonAsync("api/pagos", pagoForm);

            if (response.IsSuccessStatusCode)
            {
                // Solo recargamos si el filtro es TODAS o el estado después del pago no cambiará
                await CargarFacturas(); 
                CerrarModalPago();
            }
            else
            {
                var errorContent = await response.Content.ReadFromJsonAsync<ErrorResponse>() 
                                   ?? new ErrorResponse { Message = "Error desconocido al registrar el pago." };
                mensajePagoError = errorContent.Message;
            }
        }
        catch (Exception ex)
        {
            mensajePagoError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            guardandoPago = false;
        }
    }
    
    
    // --- Lógica de Estilos y Clases ---
    private string GetBadgeClass(decimal saldo)
    {
        if (saldo <= 0) return "bg-success";
        if (facturaParaPago?.Total > 0 && saldo < facturaParaPago?.Total * 0.5m) return "bg-warning";
        return "bg-danger";
    }

    private string GetEstadoBadgeClass(string estado)
    {
        return estado switch
        {
            "PAGADA" => "bg-success",
            "PENDIENTE" => "bg-warning",
            _ => "bg-secondary"
        };
    }
    
    private string GetSaldoClass(decimal saldo)
    {
        if (saldo <= 0) return "text-success";
        return "text-danger";
    }

    // --- DTOs (Data Transfer Objects) Modificados ---
    // NOTA: Se añade Pagos al DTO para que Reportes.razor funcione sin el fetch de detalle completo
    public class FacturaDto
    {
        public int IdFactura { get; set; }
        public string? NumeroFactura { get; set; }
        public DateTime FechaEmision { get; set; }
        public decimal Subtotal { get; set; }
        public decimal Iva { get; set; }
        public decimal Total { get; set; }
        public string Estado { get; set; } = string.Empty;
        public decimal SaldoPendiente { get; set; } 
        public ClienteDto? Cliente { get; set; }
        public List<DetalleDto>? Detalles { get; set; }

    }

    public class ClienteDto
    {
        public string? Nombres { get; set; }
        public string? Apellidos { get; set; }
        public string? Correo { get; set; }
        public string? Identificacion { get; set; }
        public string? Direccion { get; set; }
    }

    public class DetalleDto
    {
        public string? NombreProducto { get; set; }
        public int Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal TotalLinea { get; set; }
    }
    
    public class PagoDto
    {
        public int IdPago { get; set; }
        public decimal Monto { get; set; }
        public string MetodoPago { get; set; } = string.Empty;
        public DateTime FechaPago { get; set; }
        public UsuarioDto? Usuario { get; set; }
    }
    
    public class PagoRequestDto
    {
        [Required(ErrorMessage = "El ID de la factura es obligatorio.")]
        public int IdFactura { get; set; }

        [Required(ErrorMessage = "El monto es obligatorio.")]
        [Range(0.01, (double)decimal.MaxValue, ErrorMessage = "El monto debe ser positivo.")]
        public decimal Monto { get; set; }

        [Required(ErrorMessage = "El método de pago es obligatorio.")]
        public string MetodoPago { get; set; } = string.Empty;
        
        public int IdUsuario { get; set; } = 1; 
    }
    
    public class UsuarioDto
    {
        public int IdUsuario { get; set; }
        public string NombreUsuario { get; set; } = string.Empty;
    }
    
    public class ErrorResponse
    {
        public string? Message { get; set; }
    }
}