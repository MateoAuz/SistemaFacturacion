@page "/ventas"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SistemaFacturacion.Domain.Entities
@using SistemaFacturacion.Application.Contracts
@inject IHttpClientFactory HttpFactory
@inject ITaxCalculator TaxCalculator
@inject IJSRuntime JS

<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-cart-check"></i> Nueva Factura de Venta</h1>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-modern">@mensajeError</div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-modern">@mensajeExito</div>
}

<div class="card-modern">
    <h5>1. Buscar Cliente</h5>
    <div class="row">
        <div class="col-md-5">
            <label class="form-label">Buscar por Identificación (Cédula/RUC)</label>
            <div class="input-group">
                <input type="text" class="form-control" @bind="busquedaClienteId" placeholder="Escribe la identificación..." />
                <button class="btn btn-primary" @onclick="BuscarCliente"><i class="bi bi-search"></i> Buscar</button>
            </div>
        </div>
        
        @if (clienteSeleccionado != null)
        {
            <div class="col-md-7">
                <label class="form-label">Cliente Seleccionado:</label>
                <div class="alert alert-info alert-modern mb-0 p-3">
                    <strong>@clienteSeleccionado.Nombres @clienteSeleccionado.Apellidos</strong><br/>
                    <small>@clienteSeleccionado.Identificacion | @clienteSeleccionado.Correo</small>
                </div>
            </div>
        }
    </div>
</div>

<div class="card-modern">
    <h5>2. Añadir Productos</h5>
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Buscar por Código o Nombre</label>
            <input type="text" class="form-control" @bind="busquedaProductoQuery" @bind:event="oninput" @onkeyup="BuscarProductos" placeholder="Escribe el código o nombre..." />
            
            @if (productosEncontrados.Any())
            {
                <ul class="list-group mt-2" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var p in productosEncontrados)
                    {
                        <li class="list-group-item list-group-item-action" @onclick="() => SeleccionarProducto(p)">
                            <strong>@p.Codigo</strong> - @p.Nombre (Stock: @p.StockActual, Precio: @p.PrecioVenta.ToString("C"))
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="col-md-3">
            <label class="form-label">Producto</label>
            <input type="text" class="form-control" disabled value="@productoParaAnadir.Nombre" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Cantidad</label>
            <input type="number" class="form-control" @bind="productoParaAnadir.Cantidad" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-success btn-modern w-100" @onclick="AnadirDetalle" disabled="@(productoParaAnadir.IdProducto == 0 || productoParaAnadir.Cantidad <= 0)">
                <i class="bi bi-plus-circle"></i> Añadir
            </button>
        </div>
    </div>
</div>

<div class="card-modern">
    <h5>3. Detalle de la Venta</h5>
    <div class="table-modern">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>P. Unitario</th>
                    <th>Total Línea</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (!detallesFactura.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted p-4">Aún no hay productos añadidos...</td>
                    </tr>
                }
                @foreach (var det in detallesFactura)
                {
                    <tr>
                        <td>@det.Producto?.Codigo</td>
                        <td>@det.Producto?.Nombre</td>
                        <td class="text-center">@det.Cantidad</td>
                        <td class="text-end">@det.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end">@det.TotalLinea.ToString("N2")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-danger btn-modern" @onclick="() => QuitarDetalle(det)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="border-top: 2px solid #333;">
                    <td colspan="3"></td>
                    <td class="text-end"><strong>SUBTOTAL:</strong></td>
                    <td class="text-end"><strong>@factura.Subtotal.ToString("N2")</strong></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="3"></td>
                    <td class="text-end"><strong>IVA (15%):</strong></td>
                    <td class="text-end"><strong>@factura.Iva.ToString("N2")</strong></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="3"></td>
                    <td class="text-end fs-5"><strong>TOTAL:</strong></td>
                    <td class="text-end fs-5"><strong>@factura.Total.ToString("N2")</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
    
    <div class="text-end mt-4">
        <button class="btn btn-success btn-lg btn-modern" @onclick="GuardarFactura" disabled="@(clienteSeleccionado == null || !detallesFactura.Any() || guardando)">
            @if (guardando)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            <i class="bi bi-save"></i> Generar Factura
        </button>
    </div>
</div>


@code {
    private HttpClient _http => HttpFactory.CreateClient("LocalApi");

    // Búsqueda Cliente
    private string busquedaClienteId = "";
    private Cliente? clienteSeleccionado;

    // Búsqueda Producto
    private string busquedaProductoQuery = "";
    private List<Producto> productosEncontrados = new();
    private List<Producto> cacheProductos = new();
    private DetalleFacturaVM productoParaAnadir = new();

    // Factura
    private Factura factura = new();
    private List<DetalleFacturaVM> detallesFactura = new();
    private bool guardando = false;
    private string? mensajeError;
    private string? mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        // Cargar todos los productos en caché para búsqueda local
        try
        {
            cacheProductos = await _http.GetFromJsonAsync<List<Producto>>("api/productos") ?? new();
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudieron cargar los productos: {ex.Message}";
        }
    }

    private async Task BuscarCliente()
    {
        LimpiarMensajes();
        if (string.IsNullOrWhiteSpace(busquedaClienteId)) return;
        
        try
        {
            clienteSeleccionado = await _http.GetFromJsonAsync<Cliente>($"api/clientes/by-identificacion/{busquedaClienteId.Trim()}");
            if(clienteSeleccionado == null)
            {
                mensajeError = "Cliente no encontrado.";
            }
        }
        catch (Exception)
        {
            clienteSeleccionado = null;
            mensajeError = "Cliente no encontrado o error al buscar.";
        }
    }

    private void BuscarProductos()
    {
        if (string.IsNullOrWhiteSpace(busquedaProductoQuery) || busquedaProductoQuery.Length < 2)
        {
            productosEncontrados.Clear();
            return;
        }

        var query = busquedaProductoQuery.ToLower();
        productosEncontrados = cacheProductos
            .Where(p => p.Estado && (
                        p.Codigo.ToLower().Contains(query) || 
                        p.Nombre.ToLower().Contains(query))
                   )
            .Take(5)
            .ToList();
    }

    private void SeleccionarProducto(Producto p)
    {
        productoParaAnadir = new DetalleFacturaVM
        {
            IdProducto = p.IdProducto,
            Nombre = p.Nombre,
            Codigo = p.Codigo,
            PrecioUnitario = p.PrecioVenta,
            Cantidad = 1,
            Producto = p // Guardar referencia
        };
        busquedaProductoQuery = p.Nombre;
        productosEncontrados.Clear();
    }

    private void AnadirDetalle()
    {
        LimpiarMensajes();
        
        // Validar stock
        if (productoParaAnadir.Cantidad > productoParaAnadir.Producto?.StockActual)
        {
            mensajeError = $"Stock insuficiente para {productoParaAnadir.Nombre}. Disponible: {productoParaAnadir.Producto?.StockActual}";
            return;
        }

        // Evitar duplicados
        var existente = detallesFactura.FirstOrDefault(d => d.IdProducto == productoParaAnadir.IdProducto);
        if (existente != null)
        {
            existente.Cantidad += productoParaAnadir.Cantidad;
            existente.TotalLinea = existente.Cantidad * existente.PrecioUnitario;
        }
        else
        {
            productoParaAnadir.TotalLinea = productoParaAnadir.Cantidad * productoParaAnadir.PrecioUnitario;
            detallesFactura.Add(productoParaAnadir);
        }

        // Limpiar y recalcular
        productoParaAnadir = new();
        busquedaProductoQuery = "";
        RecalcularTotales();
    }

    private void QuitarDetalle(DetalleFacturaVM det)
    {
        detallesFactura.Remove(det);
        RecalcularTotales();
    }

    private void RecalcularTotales()
    {
        var subtotal = detallesFactura.Sum(d => d.TotalLinea);
        var calculo = TaxCalculator.CalcularImpuestos(subtotal);
        
        factura.Subtotal = calculo.Subtotal;
        factura.Iva = calculo.MontoIva;
        factura.Total = calculo.Total;
    }

    private async Task GuardarFactura()
    {
        LimpiarMensajes();
        if (clienteSeleccionado == null)
        {
            mensajeError = "Debe seleccionar un cliente.";
            return;
        }
        if (!detallesFactura.Any())
        {
            mensajeError = "Debe añadir al menos un producto.";
            return;
        }

        guardando = true;

        // Mapear el VM a la entidad real
        Factura facturaAGuardar = new Factura
        {
            IdCliente = clienteSeleccionado.IdCliente,
            Detalles = detallesFactura.Select(d => new DetalleFactura
            {
                IdProducto = d.IdProducto,
                Cantidad = d.Cantidad,
                PrecioUnitario = d.PrecioUnitario,
                // TotalLinea ya no se envía, la BD lo calcula
                Producto = null 
            }).ToList()
        };
        try
        {
            var response = await _http.PostAsJsonAsync("api/facturas", facturaAGuardar);

            if (response.IsSuccessStatusCode)
            {
                var facturaCreada = await response.Content.ReadFromJsonAsync<Factura>();
                mensajeExito = $"¡Factura {facturaCreada?.NumeroFactura} guardada exitosamente! Total: {facturaCreada?.Total.ToString("C")}";
                // Limpiar todo
                LimpiarFormulario();
                await OnInitializedAsync(); // Recargar productos (stock)
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<object>();
                mensajeError = $"Error al guardar: {error}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void LimpiarMensajes()
    {
        mensajeError = null;
        mensajeExito = null;
    }

    private void LimpiarFormulario()
    {
        busquedaClienteId = "";
        clienteSeleccionado = null;
        busquedaProductoQuery = "";
        productoParaAnadir = new();
        detallesFactura.Clear();
        RecalcularTotales();
    }

    // Usamos una clase VM (ViewModel) para guardar la referencia al producto
    private class DetalleFacturaVM : DetalleFactura
    {
        public string? Nombre { get; set; }
        public string? Codigo { get; set; }
    }
}