@page "/ventas"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SistemaFacturacion.Domain.Entities
@using SistemaFacturacion.Application.Contracts
@using SistemaFacturacion.Web.Services
@inject IHttpClientFactory HttpFactory
@inject ITaxCalculator TaxCalculator
@inject IJSRuntime JS
@inject AuthStateService AuthState

<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-cart-check"></i> Nueva Factura de Venta</h1>
    <small class="text-white-50">Vendedor: @nombreVendedorActual</small>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-modern fade-in">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
    </div>
}
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success alert-modern fade-in">
        <i class="bi bi-check-circle-fill me-2"></i> @mensajeExito
    </div>
}

<div class="card-modern">
    <h5 class="mb-3 border-bottom pb-2 text-primary"><i class="bi bi-person-vcard"></i> Datos del Cliente</h5>

    @if (clienteSeleccionado == null)
    {
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Buscar Cliente</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                    <input type="text" class="form-control" @bind="busquedaClienteQuery" @bind:event="oninput"
                        @onkeyup="FiltrarClientes"
                        placeholder="Escribe el Nombre, Apellido o Número de Identificación..." />
                </div>

                @if (clientesFiltrados.Any())
                {
                    <div class="list-group shadow-sm position-absolute w-75" style="z-index: 1000; margin-top: 5px;">
                        @foreach (var c in clientesFiltrados)
                        {
                            <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                @onclick="() => SeleccionarCliente(c)">
                                <div>
                                    <strong class="text-primary">@c.Nombres @c.Apellidos</strong>
                                    <br>
                                    <small class="text-muted">
                                        <i class="bi bi-card-heading"></i> @c.Identificacion
                                        @if (!string.IsNullOrEmpty(c.Correo))
                                        {
                                            <span> | <i class="bi bi-envelope"></i>
                                                @c.Correo</span>
                                        }
                                    </small>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </button>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(busquedaClienteQuery) && busquedaClienteQuery.Length > 2)
                {
                    <div class="alert alert-warning mt-2 mb-0 p-2 small">
                        <i class="bi bi-info-circle"></i> No se encontraron clientes. ¿Desea <a href="/clientes"
                            target="_blank">crear uno nuevo</a>?
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info alert-modern mb-0 p-3 fade-in">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="bg-white p-2 rounded-circle text-primary me-3 shadow-sm">
                        <i class="bi bi-person-check-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">@clienteSeleccionado.Nombres @clienteSeleccionado.Apellidos</h5>
                        <small class="text-muted">
                            <strong>@clienteSeleccionado.TipoIdentificacion:</strong> @clienteSeleccionado.Identificacion
                            @if (!string.IsNullOrEmpty(clienteSeleccionado.Telefono))
                            {
                                <span> | <strong>Tel:</strong>
                                    @clienteSeleccionado.Telefono</span>
                            }
                            @if (!string.IsNullOrEmpty(clienteSeleccionado.Correo))
                            {
                                <span> | <strong>Email:</strong>
                                    @clienteSeleccionado.Correo</span>
                            }
                        </small>
                        <div class="small text-muted mt-1"><i class="bi bi-geo-alt"></i> @(clienteSeleccionado.Direccion ??
                                                    "Sin dirección registrada")</div>
                    </div>
                </div>
                <button class="btn btn-outline-danger btn-sm bg-white" @onclick="LimpiarCliente" title="Cambiar cliente">
                    <i class="bi bi-x-lg"></i> Cambiar
                </button>
            </div>
        </div>
    }
</div>

<div class="card-modern">
    <h5 class="mb-3 border-bottom pb-2 text-primary"><i class="bi bi-box-seam"></i> Productos</h5>

    <div class="row g-3 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label"><i class="bi bi-funnel"></i> Categoría</label>
            <select class="form-select" @bind="filtroCategoria">
                <option value="">Todas</option>
                @foreach (var cat in categoriasDisponibles)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>

        <div class="col-md-6">
            <label class="form-label">Buscar Producto</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" @bind="busquedaProductoQuery" @bind:event="oninput"
                    @onkeyup="FiltrarProductos" placeholder="Código o nombre del producto..."
                    disabled="@(clienteSeleccionado == null)" />
            </div>
        </div>
    </div>

    @if (productosFiltrados.Any())
    {
        <div class="list-group shadow-sm mb-3 fade-in"
            style="max-height: 300px; overflow-y: auto; border: 1px solid #dee2e6;">
            @foreach (var p in productosFiltrados)
            {
                bool sinStock = p.StockTotal <= 0;
                bool porVencer = p.LotesProximosAVencer.Any();

                <button type="button"
                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(sinStock ? "bg-light text-muted" : "")"
                    @onclick="() => SeleccionarProducto(p)" disabled="@sinStock">
                    <div>
                        <div class="fw-bold">
                            @p.Nombre
                            <span class="badge bg-light text-dark border ms-2">@p.Codigo</span>
                            @if (porVencer && !sinStock)
                            {
                                <span class="badge bg-warning text-dark ms-1"><i class="bi bi-exclamation-triangle"></i> Por
                                    Vencer</span>
                            }
                        </div>
                        <small class="text-muted">@p.Categoria</small>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-primary fs-5">$@p.PrecioVenta.ToString("N2")</div>
                        <small>
                            Stock:
                            @if (sinStock)
                            {
                                <span class="badge bg-danger">Agotado</span>
                            }
                            else if (p.StockTotal < 10)
                            {

                                <span class="badge bg-warning text-dark">@p.StockTotal (Bajo)</span>
                            }
                            else
                            {

                                <span class="badge bg-success">@p.StockTotal</span>
                            }
                        </small>
                    </div>
                </button>
            }
        </div>
    }

    <div class="row g-3 align-items-end p-3 bg-light rounded border">
        <div class="col-md-5">
            <label class="form-label text-muted small">Producto Seleccionado</label>
            <input type="text" class="form-control fw-bold" disabled
                value="@(productoParaAnadir.Nombre ?? "Ninguno")" />
        </div>
        <div class="col-md-2">
            <label class="form-label text-muted small">Stock</label>
            <input type="text" class="form-control text-center" disabled
                value="@(productoParaAnadir.Producto?.StockTotal.ToString() ?? "-")" />
        </div>
        <div class="col-md-2">
            <label class="form-label fw-bold">Cantidad</label>
            <input type="number" class="form-control" @bind="productoParaAnadir.Cantidad" min="1" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-success w-100 btn-modern" @onclick="AnadirDetalle"
                disabled="@(productoParaAnadir.IdProducto == 0 || productoParaAnadir.Cantidad <= 0)">
                <i class="bi bi-plus-lg"></i> Agregar
            </button>
        </div>
    </div>
</div>

<div class="card-modern">
    <h5 class="mb-3 border-bottom pb-2 text-primary"><i class="bi bi-receipt"></i> Detalle</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th class="text-center">Cant.</th>
                    <th class="text-end">P. Unitario</th>
                    <th class="text-end">Total</th>
                    <th class="text-center"></th>
                </tr>
            </thead>
            <tbody>
                @if (!detallesFactura.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-cart3 display-6 opacity-25"></i>
                            <p class="mt-2 mb-0 small">Carrito vacío</p>
                        </td>
                    </tr>
                }
                @foreach (var det in detallesFactura)
                {
                    <tr>
                        <td><small class="text-muted">@det.Codigo</small></td>
                        <td>@det.Nombre</td>
                        <td class="text-center fw-bold">@det.Cantidad</td>
                        <td class="text-end">@det.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end fw-bold">@det.TotalLinea.ToString("N2")</td>
                        <td class="text-center">
                            <button class="btn btn-sm text-danger" @onclick="() => QuitarDetalle(det)"><i
                                    class="bi bi-trash-fill"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-light">
                <tr>
                    <td colspan="4" class="text-end">SUBTOTAL:</td>
                    <td class="text-end fw-bold">$@factura.Subtotal.ToString("N2")</td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="4" class="text-end">IVA (15%):</td>
                    <td class="text-end fw-bold">$@factura.Iva.ToString("N2")</td>
                    <td></td>
                </tr>
                <tr class="border-top border-2 border-secondary">
                    <td colspan="4" class="text-end fs-5"><strong>TOTAL A PAGAR:</strong></td>
                    <td class="text-end fs-4 text-success fw-bold">$@factura.Total.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- SECCIÓN DE PAGO -->
    @if (clienteSeleccionado != null && detallesFactura.Any())
    {
        <div class="card bg-light border-0 mt-4 p-3 fade-in">
            <h6 class="text-primary mb-3"><i class="bi bi-credit-card"></i> Método de Pago</h6>

            <div class="row align-items-center">
                <div class="col-md-5">
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var metodo in metodosPago)
                        {
                            <button type="button"
                                class="btn @(metodoPagoSeleccionado == metodo ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => SeleccionarMetodoPago(metodo)">
                                <i class="bi @ObtenerIconoMetodoPago(metodo) me-1"></i> @metodo
                            </button>
                        }
                    </div>
                </div>

                <div class="col-md-4">
                    @if (!string.IsNullOrEmpty(metodoPagoSeleccionado))
                    {
                        <div class="form-check form-switch d-flex align-items-center gap-2 fade-in">
                            <input class="form-check-input" type="checkbox" id="checkPagado" style="width: 3em; height: 1.5em;"
                                @bind="estaPagado" />
                            <label class="form-check-label fw-bold @(estaPagado ? "text-success" : "text-muted")"
                                for="checkPagado">
                                @if (estaPagado)
                                {
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                                    <span>¡Pagado!</span>
                                }
                                else
                                {
                                    <i class="bi bi-hourglass-split me-1"></i>
                                    <span>Confirmar pago</span>
                                }
                            </label>
                        </div>
                    }
                </div>

                <div class="col-md-3 text-end">
                    <span class="fs-5 fw-bold text-success">$@factura.Total.ToString("N2")</span>
                </div>
            </div>
        </div>
    }

    <!-- BOTONES DE ACCIÓN -->
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <button class="btn btn-outline-secondary" @onclick="LimpiarFormularioCompleto">
            <i class="bi bi-x-circle me-1"></i> Cancelar
        </button>

        <div class="d-flex align-items-center gap-3">
            @if (!PuedeGenerarFactura && clienteSeleccionado != null && detallesFactura.Any())
            {
                <small class="text-muted">
                    <i class="bi bi-info-circle"></i>
                    @if (string.IsNullOrEmpty(metodoPagoSeleccionado))
                    {
                        <span>Seleccione método de pago</span>
                    }
                    else if (!estaPagado)
                    {
                        <span>Confirme el pago para continuar</span>
                    }
                </small>
            }

            <button class="btn btn-success btn-lg px-4" @onclick="GuardarFactura" disabled="@(!PuedeGenerarFactura)">
                @if (guardando)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <i class="bi bi-receipt me-1"></i> Generar Factura
            </button>
        </div>
    </div>

</div>

@code {
    private HttpClient _http => HttpFactory.CreateClient("LocalApi");
    

    // CLIENTES
    private string busquedaClienteQuery = "";
    private Cliente? clienteSeleccionado;
    private List<Cliente> cacheClientes = new();
    private List<Cliente> clientesFiltrados = new();

    // PRODUCTOS
    private string busquedaProductoQuery = "";
    private string filtroCategoria = "";
    private List<Producto> cacheProductos = new();
    private List<Producto> productosFiltrados = new();
    private List<string> categoriasDisponibles = new();
    private DetalleFacturaVM productoParaAnadir = new();

    // FACTURA
    private Factura factura = new();
    private List<DetalleFacturaVM> detallesFactura = new();
    private bool guardando = false;
    private string? mensajeError;
    private string? mensajeExito;
    // PAGO (NUEVO)
    private string metodoPagoSeleccionado = "";
    private bool estaPagado = false;
    // DATOS DE SESIÓN
    private int idUsuarioActual = 0;
    private string nombreVendedorActual = "Cargando...";

    private List<string> metodosPago = new()
{
"Efectivo",
"Transferencia",
"Tarjeta"
};

    // Propiedad para saber si se puede generar factura
    private bool PuedeGenerarFactura =>
    clienteSeleccionado != null &&
    detallesFactura.Any() &&
    !string.IsNullOrEmpty(metodoPagoSeleccionado) &&
    estaPagado &&
    !guardando;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarDatosUsuario(); // ✅ Recuperar usuario logueado

            var clientes = await _http.GetFromJsonAsync<List<Cliente>>("api/clientes");
            cacheClientes = clientes ?? new List<Cliente>();

            cacheProductos = await _http.GetFromJsonAsync<List<Producto>>("api/productos?includeLotes=true") ?? new();
            categoriasDisponibles = cacheProductos
            .Where(p => !string.IsNullOrEmpty(p.Categoria))
            .Select(p => p.Categoria!)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error cargando datos iniciales: {ex.Message}";
        }
    }
    
    private async Task CargarDatosUsuario()
    {
        // Intentar obtener del servicio (memoria)
        if (AuthState.IdUsuario != 0)
        {
            idUsuarioActual = AuthState.IdUsuario;
            nombreVendedorActual = AuthState.NombreUsuario ?? "Vendedor";
        }
        else
        {
            // Si se recargó la página, recuperar del LocalStorage
            try 
            {
                var idStr = await JS.InvokeAsync<string>("localStorage.getItem", "userId");
                var nameStr = await JS.InvokeAsync<string>("localStorage.getItem", "userName");
                
                if (int.TryParse(idStr, out int id))
                {
                    idUsuarioActual = id;
                    nombreVendedorActual = nameStr ?? "Vendedor";
                    
                    // Restaurar estado global por si acaso
                    var rolStr = await JS.InvokeAsync<string>("localStorage.getItem", "userRole");
                    AuthState.SetUsuario(rolStr, nombreVendedorActual, idUsuarioActual);
                }
            }
            catch { /* Ignorar errores de JS si no hay datos */ }
        }
    }

    // --- LÓGICA CLIENTES MEJORADA ---
    private void FiltrarClientes()
    {
        if (string.IsNullOrWhiteSpace(busquedaClienteQuery))
        {
            clientesFiltrados.Clear();
            return;
        }

        var query = busquedaClienteQuery.ToLower().Trim();


        clientesFiltrados = cacheClientes
        .Where(c => c.Estado && (
        c.Nombres.ToLower().Contains(query) ||
        (c.Apellidos != null && c.Apellidos.ToLower().Contains(query)) ||
        c.Identificacion.Contains(query)
        ))
        .Take(5)
        .ToList();
    }

    private void SeleccionarCliente(Cliente c)
    {
        clienteSeleccionado = c;
        busquedaClienteQuery = "";
        clientesFiltrados.Clear();
        mensajeError = null;
    }

    private void LimpiarCliente()
    {
        clienteSeleccionado = null;
        busquedaClienteQuery = "";
    }

    // --- LÓGICA PRODUCTOS (Ya existente y mejorada) ---
    private void FiltrarProductos()
    {
        if (string.IsNullOrWhiteSpace(busquedaProductoQuery) && string.IsNullOrWhiteSpace(filtroCategoria))
        {
            productosFiltrados.Clear();
            return;
        }

        var query = busquedaProductoQuery.ToLower().Trim();

        productosFiltrados = cacheProductos
        .Where(p => p.Estado)
        .Where(p => string.IsNullOrEmpty(filtroCategoria) || p.Categoria == filtroCategoria)
        .Where(p => string.IsNullOrEmpty(query) ||
        p.Codigo.ToLower().Contains(query) ||
        p.Nombre.ToLower().Contains(query))
        .Take(8)
        .ToList();
    }

    private void SeleccionarProducto(Producto p)
    {
        productoParaAnadir = new DetalleFacturaVM
        {
            IdProducto = p.IdProducto,
            Nombre = p.Nombre,
            Codigo = p.Codigo,
            PrecioUnitario = p.PrecioVenta,
            Cantidad = 1,
            Producto = p
        };

        busquedaProductoQuery = "";
        productosFiltrados.Clear();
    }

    private void AnadirDetalle()
    {
        LimpiarMensajes();
        if (productoParaAnadir.Producto == null) return;

        // Validar stock acumulado (por si agrega el mismo producto varias veces)
        var existente = detallesFactura.FirstOrDefault(d => d.IdProducto == productoParaAnadir.IdProducto);
        int cantidadTotal = productoParaAnadir.Cantidad + (existente?.Cantidad ?? 0);

        if (cantidadTotal > productoParaAnadir.Producto.StockTotal)
        {
            mensajeError = $"⚠️ Stock insuficiente. Disponible: {productoParaAnadir.Producto.StockTotal}, Intentas vender: {cantidadTotal}";
            return;
        }

        if (existente != null)
        {
            existente.Cantidad = (short)cantidadTotal;
            existente.TotalLinea = existente.Cantidad * existente.PrecioUnitario;
        }
        else
        {
            productoParaAnadir.TotalLinea = productoParaAnadir.Cantidad * productoParaAnadir.PrecioUnitario;
            detallesFactura.Add(productoParaAnadir);
        }

        productoParaAnadir = new();
        RecalcularTotales();
    }

    private void QuitarDetalle(DetalleFacturaVM det)
    {
        detallesFactura.Remove(det);
        RecalcularTotales();
    }

    private void RecalcularTotales()
    {
        var subtotal = detallesFactura.Sum(d => d.TotalLinea);
        var calculo = TaxCalculator.CalcularImpuestos(subtotal);
        factura.Subtotal = calculo.Subtotal;
        factura.Iva = calculo.MontoIva;
        factura.Total = calculo.Total;
    }

    private async Task GuardarFactura()
{
    LimpiarMensajes();
    
    // Validaciones
    if (!PuedeGenerarFactura) 
    { 
        if (clienteSeleccionado == null)
            mensajeError = "⚠️ Falta seleccionar cliente";
        else if (!detallesFactura.Any())
            mensajeError = "⚠️ Agregue al menos un producto";
        else if (string.IsNullOrEmpty(metodoPagoSeleccionado))
            mensajeError = "⚠️ Seleccione un método de pago";
        else if (!estaPagado)
            mensajeError = "⚠️ Confirme el pago para continuar";
        return; 
    }

    guardando = true;
    StateHasChanged();
    
    try
    {
        // 1️⃣ CREAR LA FACTURA (se crea con estado PENDIENTE por defecto)
        Factura nuevaFactura = new Factura
        {
                IdCliente = clienteSeleccionado!.IdCliente,
                IdUsuario = idUsuarioActual, // ✅ Usar el ID del usuario logueado
                Detalles = detallesFactura.Select(d => new DetalleFactura
                {
                    IdProducto = d.IdProducto,
                    Cantidad = (short)d.Cantidad,
                    PrecioUnitario = d.PrecioUnitario
                }).ToList()
            };

        var responseFactura = await _http.PostAsJsonAsync("api/facturas", nuevaFactura);
        
        if (!responseFactura.IsSuccessStatusCode)
        {
            mensajeError = $"❌ Error al crear factura: {await responseFactura.Content.ReadAsStringAsync()}";
            return;
        }

        var facturaCreada = await responseFactura.Content.ReadFromJsonAsync<Factura>();
        
        if (facturaCreada == null)
        {
            mensajeError = "❌ Error: No se pudo obtener la factura creada";
            return;
        }

        // 2️⃣ REGISTRAR EL PAGO (esto cambia el estado a PAGADA)
        var pagoRequest = new PagoRequestDto
            {
                IdFactura = facturaCreada.IdFactura,
                Monto = facturaCreada.Total,
                MetodoPago = metodoPagoSeleccionado,
                IdUsuario = idUsuarioActual // ✅ Usar el ID del usuario logueado
            };

        var responsePago = await _http.PostAsJsonAsync("api/pagos", pagoRequest);
        
        if (!responsePago.IsSuccessStatusCode)
        {
            // La factura se creó pero el pago falló
            mensajeError = $"⚠️ Factura {facturaCreada.NumeroFactura} creada, pero error al registrar pago: {await responsePago.Content.ReadAsStringAsync()}";
            return;
        }

        // ✅ TODO EXITOSO
        mensajeExito = $"✅ Factura {facturaCreada.NumeroFactura} generada y pagada con {metodoPagoSeleccionado}";
        LimpiarFormularioCompleto();
        await OnInitializedAsync(); // Recargar productos (actualizar stock)
    }
    catch (Exception ex) 
    { 
        mensajeError = $"❌ Error de red: {ex.Message}"; 
    }
    finally 
    { 
        guardando = false; 
        StateHasChanged();
    }
}


    private void LimpiarMensajes() { mensajeError = null; mensajeExito = null; }

    private void LimpiarFormularioCompleto()
    {
        LimpiarCliente();
        busquedaProductoQuery = "";
        filtroCategoria = "";
        productoParaAnadir = new();
        detallesFactura.Clear();
        metodoPagoSeleccionado = "";
        estaPagado = false;
        RecalcularTotales();
    }

    private void SeleccionarMetodoPago(string metodo)
    {
        metodoPagoSeleccionado = metodo;
        estaPagado = false; // Resetear confirmación al cambiar método
    }

    private string ObtenerIconoMetodoPago(string metodo) => metodo switch
    {
        "Efectivo" => "bi-cash-stack",
        "Transferencia" => "bi-bank",
        "Tarjeta" => "bi-credit-card-2-front",
        _ => "bi-wallet2"
    };


    private class DetalleFacturaVM : DetalleFactura
    {
        public string? Nombre { get; set; }
        public string? Codigo { get; set; }
    }

