@page "/validacion"
@rendermode InteractiveServer
@using SistemaFacturacion.Application.Contracts
@using SistemaFacturacion.Application.DTOs
@inject IHttpClientFactory HttpFactory
@inject IValidacionFacturaService ValidacionService
@inject IXmlValidationService XmlValidator
@inject IJSRuntime JS

<PageTitle>Validación de Comprobantes</PageTitle>

<!-- ENCABEZADO PRINCIPAL -->
<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-shield-check"></i> Validación de Comprobantes Electrónicos</h1>
</div>

<!-- 🔔 NOTIFICACIONES -->
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success-custom text-center fade-in">
        @mensajeExito
    </div>
}

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-error-custom text-center fade-in">
        @mensajeError
    </div>
}

@if (isLoading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Cargando facturas...</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped mb-0 align-middle">
                <thead class="text-white" style="background-color:#4a56e2;">
                    <tr class="text-center">
                        <th scope="col">N° Factura</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Total</th>
                        <th scope="col">Estado</th>
                        <th scope="col">XML</th>
                        <th scope="col" style="width:320px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (facturas.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                No hay facturas pagadas disponibles
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var factura in facturas)
                        {
                            <tr>
                                <td class="fw-bold">@factura.NumeroFactura</td>
                                <td>@factura.NombreCliente</td>
                                <td>@factura.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-bold">$@factura.Total.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge bg-success">@factura.Estado</span>
                                </td>
                                <td class="text-center">
                                    @if (factura.TieneXmlGenerado)
                                    {
                                        <span class="badge bg-info">Generado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Sin generar</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <button class="btn btn-sm btn-outline-success" 
                                                @onclick="() => GenerarXml(factura.IdFactura)"
                                                title="Generar XML">
                                            <i class="bi bi-file-earmark-code"></i> Generar
                                        </button>

                                        <button class="btn btn-sm btn-outline-primary" 
                                                @onclick="() => DescargarXml(factura.IdFactura)"
                                                disabled="@(!factura.TieneXmlGenerado)"
                                                title="Descargar XML">
                                            <i class="bi bi-download"></i> Descargar
                                        </button>

                                        <button class="btn btn-sm btn-outline-info" 
                                                @onclick="() => ValidarXml(factura.IdFactura)"
                                                disabled="@(!factura.TieneXmlGenerado)"
                                                title="Validar Estructura">
                                            <i class="bi bi-check-circle"></i> Validar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal de Resultados de Validación -->
@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-shield-check"></i> Resultado de Validación XSD
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (validacionExitosa)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill fs-4"></i>
                            <strong>¡Validación Exitosa!</strong>
                            <p class="mb-0 mt-2">El XML cumple con la estructura XSD del SRI.</p>
                        </div>
                    }
                    else if (erroresValidacion.Any())
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-x-circle-fill fs-4"></i>
                            <strong>Errores de Validación</strong>
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <h6>Detalles de los errores:</h6>
                                <ul class="list-unstyled">
                                    @foreach (var error in erroresValidacion)
                                    {
                                        <li class="mb-2">
                                            <i class="bi bi-arrow-right text-danger"></i> @error
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FacturaValidacionDto> facturas = new();
    private bool isLoading = true;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private bool validacionExitosa = false;
    private List<string> erroresValidacion = new();
    private bool mostrarModal = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarFacturas();
    }

    private async Task CargarFacturas()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            
            facturas = await ValidacionService.GetFacturasPagadasParaValidacionAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"❌ Error al cargar facturas: {ex.Message}", false);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GenerarXml(int idFactura)
    {
        try
        {
            await ValidacionService.GenerarXmlFacturaAsync(idFactura);
            MostrarMensaje("✅ XML generado exitosamente", true);
            await CargarFacturas();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"❌ Error al generar XML: {ex.Message}", false);
        }
    }

    private async Task DescargarXml(int idFactura)
{
    try
    {
        var xmlContent = await XmlValidator.DescargarXmlFacturaAsync(idFactura);
        var factura = facturas.FirstOrDefault(f => f.IdFactura == idFactura);
        var fileName = $"FAC_{factura?.NumeroFactura?.Replace("-", "")}_{DateTime.Now:yyyyMMddHHmmss}.xml";
        
        var bytes = System.Text.Encoding.UTF8.GetBytes(xmlContent);
        var base64 = Convert.ToBase64String(bytes);
        
        // ✅ AGREGAR EL PARÁMETRO FALTANTE "application/xml"
        await JS.InvokeVoidAsync("downloadFile", fileName, "application/xml", base64);
        
        MostrarMensaje("✅ XML descargado correctamente", true);
    }
    catch (Exception ex)
    {
        MostrarMensaje($"❌ Error al descargar XML: {ex.Message}", false);
    }
}


    private async Task ValidarXml(int idFactura)
    {
        try
        {
            erroresValidacion.Clear();
            
            var (isValid, errors) = await ValidacionService.ValidarEstructuraXmlAsync(idFactura);
            
            validacionExitosa = isValid;
            erroresValidacion = errors;
            mostrarModal = true;
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"❌ Error al validar XML: {ex.Message}", false);
        }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        StateHasChanged();
    }

    private void MostrarMensaje(string texto, bool esExito)
    {
        if (esExito)
        {
            mensajeExito = texto;
            mensajeError = string.Empty;
        }
        else
        {
            mensajeError = texto;
            mensajeExito = string.Empty;
        }
        
        StateHasChanged();

        // Ocultar mensaje después de 4 segundos
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            mensajeExito = string.Empty;
            mensajeError = string.Empty;
            await InvokeAsync(StateHasChanged);
        });
    }
}

<style>
    .page-header {
        background: linear-gradient(135deg, #4a56e2 0%, #6a11cb 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }

    .fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .alert-success-custom {
        background-color: #d4edda;
        border-color: #c3e6cb;
        color: #155724;
    }

    .alert-error-custom {
        background-color: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }

    .table th {
        border: none;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35rem 0.65rem;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
    }

    .modal-backdrop {
        background-color: rgba(0, 0, 0, 0.5);
    }
</style>
