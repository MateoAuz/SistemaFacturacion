@page "/login"
@rendermode InteractiveServer
@using SistemaFacturacion.Application.Contracts
@inject IUsuarioRepository UsuarioRepository
@inject NavigationManager Navigation


<div class="login-fullscreen">
    <div class="login-container">
        <div class="login-card">
            <div class="text-center mb-4">
                <div class="login-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h2 class="mt-3">Sistema de Facturación</h2>
                <p class="text-muted">Ingrese sus credenciales</p>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger alert-modern">
                    <i class="bi bi-exclamation-triangle"></i> @error
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control" @bind="usuario" placeholder="Ingrese su usuario" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" @bind="password" placeholder="Ingrese su contraseña" 
                           @onkeypress="HandleKeyPress" />
                </div>
            </div>

            <button class="btn btn-primary w-100 btn-modern" @onclick="IniciarSesion" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
            </button>

            <!-- Información de testing -->
            <div class="mt-3 text-center">
                <small class="text-muted">
                    Usuarios de prueba: admin / 123456
                </small>
            </div>
        </div>
    </div>
</div>

@code {
    private string usuario = "";
    private string password = "";
    private string? error;
    private bool isLoading = false;

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            IniciarSesion();
        }
    }

    private async Task IniciarSesion()
    {
        error = null;
        isLoading = true;

        if (string.IsNullOrWhiteSpace(usuario) || string.IsNullOrWhiteSpace(password))
        {
            error = "Complete todos los campos";
            isLoading = false;
            return;
        }

        try
        {
            // Autenticar usando el Repository
            var usuarioAutenticado = await UsuarioRepository.ValidarCredencialesAsync(usuario, password);
            
            if (usuarioAutenticado != null)
            {
                // Login exitoso
                error = null;
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                error = "Usuario o contraseña incorrectos";
            }
        }
        catch (Exception ex)
        {
            error = $"Error al conectar con la base de datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}