@page "/editar-cliente/{IdCliente:int}"
@rendermode InteractiveServer
@using SistemaFacturacion.Domain.Entities
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<div class="page-header">
    <h1 class="mb-0">
        <i class="bi @(IdCliente == 0 ? "bi-person-plus" : "bi-pencil-square")"></i> 
        @(IdCliente == 0 ? "Nuevo Cliente" : "Editar Cliente")
    </h1>
</div>

@if (cargando)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card-modern p-4">
        <EditForm Model="cliente" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-error-custom mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
                </div>
            }

            <div class="row g-3">
                <div class="col-12 border-bottom pb-3 mb-3">
                    <h6 class="text-primary mb-3 fw-bold"><i class="bi bi-card-heading"></i> Datos de Identificación</h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Tipo de Documento *</label>
                            <InputSelect class="form-select" @bind-Value="cliente.TipoIdentificacion">
                                <option value="CEDUL">Cédula</option>
                                <option value="RUC">RUC</option>
                                <option value="PASAP">Pasaporte (Extranjero)</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => cliente.TipoIdentificacion)" />
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Número de Identificación *</label>
                            <div class="input-group">
                                <InputText class="form-control" 
                                           @bind-Value="cliente.Identificacion" 
                                           @onfocusout="ValidarYVerificarExistencia"
                                           placeholder="@(cliente.TipoIdentificacion == "PASAP" ? "Pasaporte" : "Solo números")" />
                                
                                <span class="input-group-text">
                                    @if(validandoIdentificacion)
                                    {
                                        <div class="spinner-border spinner-border-sm text-secondary"></div>
                                    }
                                    else if(identificacionEsValida) 
                                    { 
                                        <i class="bi bi-check-circle-fill text-success" title="Identificación válida y disponible"></i> 
                                    }
                                    else if(!string.IsNullOrEmpty(mensajeValidacion)) 
                                    { 
                                        <i class="bi bi-x-circle-fill text-danger" title="Inválida o Duplicada"></i> 
                                    }
                                    else 
                                    { 
                                        <i class="bi bi-hash"></i> 
                                    }
                                </span>
                            </div>
                            
                            @if(!string.IsNullOrEmpty(mensajeValidacion))
                            {
                                <div class="text-danger small mt-1 fw-bold">
                                    <i class="bi bi-exclamation-circle"></i> @mensajeValidacion
                                </div>
                            }
                            <ValidationMessage For="@(() => cliente.Identificacion)" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Nombres *</label>
                    <InputText class="form-control" @bind-Value="cliente.Nombres" />
                    <ValidationMessage For="@(() => cliente.Nombres)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Apellidos</label>
                    <InputText class="form-control" @bind-Value="cliente.Apellidos" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Correo Electrónico</label>
                    <InputText class="form-control" type="email" @bind-Value="cliente.Correo" />
                    <ValidationMessage For="@(() => cliente.Correo)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control" @bind-Value="cliente.Telefono" />
                </div>
                <div class="col-12">
                    <label class="form-label">Dirección</label>
                    <InputText class="form-control" @bind-Value="cliente.Direccion" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-secondary" @onclick="Volver">Cancelar</button>
                <button type="submit" class="btn btn-success btn-modern" disabled="@(guardando || !identificacionEsValida)">
                    @if(guardando) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    <i class="bi bi-save me-2"></i> Guardar
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int IdCliente { get; set; }
    
    private Cliente cliente = new();
    private string identificacionOriginal = ""; 
    private bool cargando = true;
    private bool guardando = false;
    
    // Variables para validación en tiempo real
    private string? mensajeError;
    private string? mensajeValidacion;
    private bool identificacionEsValida = false; // Controla si el botón Guardar se activa
    private bool validandoIdentificacion = false;

    protected override async Task OnInitializedAsync()
    {
        var http = HttpClientFactory.CreateClient("LocalApi");
        if (IdCliente != 0)
        {
            cliente = await http.GetFromJsonAsync<Cliente>($"api/clientes/{IdCliente}") ?? new();
            identificacionOriginal = cliente.Identificacion; 
            identificacionEsValida = true; // Asumimos válido si ya existe
        }
        else
        {
            cliente = new Cliente { TipoIdentificacion = "CEDUL", Estado = true };
            identificacionEsValida = false; // Nuevo cliente empieza inválido hasta que escriba
        }
        cargando = false;
    }

    // 🚀 ESTA ES LA FUNCIÓN CLAVE QUE PEDISTE
    private async Task ValidarYVerificarExistencia()
    {
        // 1. Resetear estados
        mensajeValidacion = null;
        identificacionEsValida = false;

        if (string.IsNullOrWhiteSpace(cliente.Identificacion)) return;

        validandoIdentificacion = true;
        StateHasChanged();

        // 2. Validar Formato (Algoritmo Cédula/RUC o Pasaporte)
        var errorFormato = cliente.ValidarIdentificacion();
        if (errorFormato != null)
        {
            mensajeValidacion = errorFormato;
            validandoIdentificacion = false;
            return;
        }

        // 3. Validar Duplicado en BD (API)
        // Solo verificamos si es un cliente NUEVO o si CAMBIÓ su identificación
        if (IdCliente == 0 || cliente.Identificacion != identificacionOriginal)
        {
            try
            {
                var http = HttpClientFactory.CreateClient("LocalApi");
                var existe = await http.GetFromJsonAsync<bool>($"api/clientes/existe/{cliente.Identificacion}");
                
                if (existe)
                {
                    mensajeValidacion = "⚠️ Esta identificación ya está registrada en el sistema.";
                    validandoIdentificacion = false;
                    return;
                }
            }
            catch (Exception)
            {
                // Si falla la API, permitimos continuar con advertencia pero no bloqueamos (opcional)
                // mensajeValidacion = "Error verificando duplicados.";
            }
        }

        // Si pasó todo:
        identificacionEsValida = true;
        validandoIdentificacion = false;
        StateHasChanged();
    }

    private async Task Guardar()
    {
        // Doble chequeo antes de enviar
        await ValidarYVerificarExistencia();
        if (!identificacionEsValida) return;

        guardando = true;
        mensajeError = null;
        
        var http = HttpClientFactory.CreateClient("LocalApi");

        try
        {
            HttpResponseMessage resp;
            if (IdCliente == 0)
                resp = await http.PostAsJsonAsync("api/clientes", cliente);
            else
                resp = await http.PutAsJsonAsync($"api/clientes/{IdCliente}", cliente);

            if (resp.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/clientes");
            }
            else
            {
                var content = await resp.Content.ReadAsStringAsync();
                mensajeError = $"No se pudo guardar: {content}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Volver() => Nav.NavigateTo("/clientes");
}