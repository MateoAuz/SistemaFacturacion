@page "/editar-cliente/{IdCliente:int}"
@rendermode InteractiveServer
@using SistemaFacturacion.Domain.Entities
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Cliente</h1>
    <p class="mb-0 mt-2 opacity-75">Modifica la información del cliente</p>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2">Cargando cliente ID: @IdCliente...</p>
    </div>
}
else if (cliente is null)
{
    <div class="alert alert-warning alert-modern">
        <i class="bi bi-exclamation-triangle"></i> Cliente no encontrado (ID: @IdCliente)
        <br><br>
        <button class="btn btn-secondary btn-sm" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </button>
    </div>
}
else
{
    <div class="card-modern">
        <EditForm Model="cliente" OnValidSubmit="Guardar" FormName="editar-cliente">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger alert-modern">
                    <i class="bi bi-exclamation-circle"></i> @mensajeError
                </div>
            }

            <div class="row g-3">
                <!-- Tipo Identificación -->
                <div class="col-md-2">
                    <label class="form-label">Tipo ID *</label>
                    <InputSelect class="form-select" @bind-Value="cliente.TipoIdentificacion">
                        <option value="">Seleccione...</option>
                        <option value="CEDUL">Cédula</option>
                        <option value="RUC">RUC</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => cliente.TipoIdentificacion)" class="text-danger small" />
                </div>

                <!-- Identificación -->
                <div class="col-md-4">
                    <label class="form-label">Identificación *</label>
                    <InputText class="form-control" @bind-Value="cliente.Identificacion" maxlength="13" />
                    <ValidationMessage For="@(() => cliente.Identificacion)" class="text-danger small" />
                    @if (!string.IsNullOrEmpty(mensajeValidacionCedula))
                    {
                        <div class="text-danger small">@mensajeValidacionCedula</div>
                    }
                </div>

                <!-- Nombres -->
                <div class="col-md-3">
                    <label class="form-label">Nombres *</label>
                    <InputText class="form-control" @bind-Value="cliente.Nombres" maxlength="60" />
                    <ValidationMessage For="@(() => cliente.Nombres)" class="text-danger small" />
                </div>

                <!-- Apellidos -->
                <div class="col-md-3">
                    <label class="form-label">Apellidos</label>
                    <InputText class="form-control" @bind-Value="cliente.Apellidos" maxlength="60" />
                    <ValidationMessage For="@(() => cliente.Apellidos)" class="text-danger small" />
                </div>

                <!-- Correo -->
                <div class="col-md-5">
                    <label class="form-label">Correo</label>
                    <InputText class="form-control" @bind-Value="cliente.Correo" type="email" maxlength="80" />
                    <ValidationMessage For="@(() => cliente.Correo)" class="text-danger small" />
                </div>

                <!-- Teléfono -->
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control" @bind-Value="cliente.Telefono" maxlength="15" />
                    <ValidationMessage For="@(() => cliente.Telefono)" class="text-danger small" />
                </div>

                <!-- Dirección -->
                <div class="col-md-4">
                    <label class="form-label">Dirección</label>
                    <InputText class="form-control" @bind-Value="cliente.Direccion" maxlength="120" />
                    <ValidationMessage For="@(() => cliente.Direccion)" class="text-danger small" />
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-success btn-modern" type="submit" disabled="@guardando">
                    <i class="bi bi-check-circle"></i>
                    @(guardando ? "Guardando..." : "Guardar Cambios")
                </button>
                <button type="button" class="btn btn-secondary btn-modern ms-2" @onclick="Volver" disabled="@guardando">
                    <i class="bi bi-arrow-left"></i> Volver
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int IdCliente { get; set; }
    private Cliente? cliente;
    private Cliente? clienteOriginal; // Para guardar los datos originales
    private bool cargando = true;
    private bool guardando = false;
    private string? mensajeError;
    private string? mensajeValidacionCedula;

    protected override async Task OnParametersSetAsync()
    {
        await CargarCliente();
    }

    private async Task CargarCliente()
    {
        cargando = true;
        LimpiarMensajes();
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient("LocalApi");
            cliente = await httpClient.GetFromJsonAsync<Cliente>($"api/clientes/{IdCliente}");

            if (cliente == null)
            {
                mensajeError = "No se pudo cargar la información del cliente";
            }
            else
            {
                // Guardar una copia de los datos originales para validación
                clienteOriginal = new Cliente
                {
                    IdCliente = cliente.IdCliente,
                    Identificacion = cliente.Identificacion,
                    TipoIdentificacion = cliente.TipoIdentificacion,
                    Nombres = cliente.Nombres,
                    Apellidos = cliente.Apellidos,
                    Correo = cliente.Correo,
                    Telefono = cliente.Telefono,
                    Direccion = cliente.Direccion,
                    Estado = cliente.Estado
                };
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar cliente: {ex.Message}";
            Console.WriteLine($"Error detallado: {ex}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task Guardar()
    {
        guardando = true;
        LimpiarMensajes();
        StateHasChanged();

        try
        {
            // DECLARAR httpClient aquí también
            var httpClient = HttpClientFactory.CreateClient("LocalApi");

            // Validación personalizada de cédula/RUC
            var errorValidacion = cliente?.ValidarIdentificacion();
            if (!string.IsNullOrEmpty(errorValidacion))
            {
                mensajeValidacionCedula = errorValidacion;
                guardando = false;
                StateHasChanged();
                return;
            }

            // Validar si la identificación ya existe (solo si cambió)
            if (clienteOriginal != null && cliente!.Identificacion != clienteOriginal.Identificacion)
            {
                var urlVerificar = $"api/clientes/existe/{cliente.Identificacion}";
                var responseVerificar = await httpClient.GetAsync(urlVerificar);

                if (responseVerificar.IsSuccessStatusCode)
                {
                    var existe = await responseVerificar.Content.ReadFromJsonAsync<bool>();
                    if (existe)
                    {
                        mensajeError = "Ya existe otro cliente con esta identificación";
                        guardando = false;
                        StateHasChanged();
                        return;
                    }
                }
            }

            // Guardar los cambios
            var response = await httpClient.PutAsJsonAsync($"api/clientes/{IdCliente}", cliente);

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/clientes");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                mensajeError = $"Error al guardar: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void LimpiarMensajes()
    {
        mensajeError = null;
        mensajeValidacionCedula = null;
    }

    private void Volver()
    {
        Nav.NavigateTo("/clientes");
    }
}