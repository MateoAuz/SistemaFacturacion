@page "/editar-cliente/{IdCliente:int}"
@rendermode InteractiveServer
@using SistemaFacturacion.Domain.Entities
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Cliente</h1>
    <p class="mb-0 mt-2 opacity-75">Modifica la información del cliente</p>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2">Cargando cliente ID: @IdCliente...</p>
    </div>
}
else if (cliente is null)
{
    <div class="alert alert-warning alert-modern">
        <i class="bi bi-exclamation-triangle"></i> Cliente no encontrado (ID: @IdCliente)
        <br><br>
        <button class="btn btn-secondary btn-sm" @onclick="Volver">
            <i class="bi bi-arrow-left"></i> Volver a la lista
        </button>
    </div>
}
else
{
    <div class="card-modern">
        <EditForm Model="cliente" OnValidSubmit="Guardar" FormName="editar-cliente">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Tipo ID</label>
                    <InputSelect class="form-select" @bind-Value="cliente.TipoIdentificacion">
                        <option value="">Seleccione...</option>
                        <option value="CEDUL">Cédula</option>
                        <option value="RUC">RUC</option>
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Identificación</label>
                    <InputText class="form-control" @bind-Value="cliente.Identificacion" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nombres</label>
                    <InputText class="form-control" @bind-Value="cliente.Nombres" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Apellidos</label>
                    <InputText class="form-control" @bind-Value="cliente.Apellidos" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Correo</label>
                    <InputText class="form-control" @bind-Value="cliente.Correo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control" @bind-Value="cliente.Telefono" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Dirección</label>
                    <InputText class="form-control" @bind-Value="cliente.Direccion" />
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger alert-modern mt-3">
                    <i class="bi bi-exclamation-circle"></i> @mensajeError
                </div>
            }

            <div class="mt-4">
                <button class="btn btn-success btn-modern" type="submit" disabled="@guardando">
                    <i class="bi bi-check-circle"></i> 
                    @(guardando ? "Guardando..." : "Guardar Cambios")
                </button>
                <button type="button" class="btn btn-secondary btn-modern ms-2" @onclick="Volver" disabled="@guardando">
                    <i class="bi bi-arrow-left"></i> Volver
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int IdCliente { get; set; }
    private Cliente? cliente;
    private bool cargando = true;
    private bool guardando = false;
    private string? mensajeError;

    protected override async Task OnParametersSetAsync()
    {
        await CargarCliente();
    }

    private async Task CargarCliente()
    {
        cargando = true;
        mensajeError = null;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient("LocalApi");
            cliente = await httpClient.GetFromJsonAsync<Cliente>($"api/clientes/{IdCliente}");
            
            if (cliente == null)
            {
                mensajeError = "No se pudo cargar la información del cliente";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar cliente: {ex.Message}";
            Console.WriteLine($"Error detallado: {ex}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task Guardar()
    {
        guardando = true;
        mensajeError = null;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient("LocalApi");
            var response = await httpClient.PutAsJsonAsync($"api/clientes/{IdCliente}", cliente);
            
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/clientes");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                mensajeError = $"Error al guardar: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/clientes");
    }
}