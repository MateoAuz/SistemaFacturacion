@page "/productos"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SistemaFacturacion.Domain.Entities
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS

<!-- Título principal -->
<div class="d-flex align-items-center mb-3">
    <h3 class="fw-bold text-primary me-2 mb-0">
        <i class="bi bi-box"></i> Gestión de Productos
    </h3>
</div>

<!-- Tabs: Activos / Inactivos -->
<div class="d-flex align-items-center mb-3">
    <button class="btn @(mostrarActivos ? "btn-primary" : "btn-outline-primary") me-2"
            @onclick="() => CambiarVista(true)">
        <i class="bi bi-diagram-3"></i> Productos Activos
        <span class="badge bg-light text-dark">@productosActivos.Count</span>
    </button>

    <button class="btn @(mostrarActivos ? "btn-outline-secondary" : "btn-secondary")"
            @onclick="() => CambiarVista(false)">
        <i class="bi bi-archive"></i> Productos Inactivos
        <span class="badge bg-light text-dark">@productosInactivos.Count</span>
    </button>
</div>

<!-- Botón Nuevo -->
@if (mostrarActivos)
{
    <button class="btn btn-primary mb-3" @onclick="Nuevo">
        <i class="bi bi-plus-circle"></i> Nuevo Producto
    </button>
}

@if (mostrarForm)
{
    <div class="card mt-4 border-0 shadow-sm">
        <div class="card-header text-white fw-bold"
             style="background-color:#4a56e2;">
            <i class="bi bi-journal-plus"></i>
            @(editando ? "Editar Producto" : "Nuevo Producto")
        </div>

        <div class="card-body">
            <EditForm EditContext="@EditContext" OnValidSubmit="@Guardar">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Código *</label>
                        <InputText class="form-control" @bind-Value="form.Codigo" />
                        <ValidationMessage For="@(() => form.Codigo)" />
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">Nombre *</label>
                        <InputText class="form-control" @bind-Value="form.Nombre" />
                        <ValidationMessage For="@(() => form.Nombre)" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Categoría</label>
                        <InputText class="form-control" @bind-Value="form.Categoria" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Precio Unitario *</label>
                        <InputNumber class="form-control" @bind-Value="form.PrecioUnitario" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Precio Venta *</label>
                        <InputNumber class="form-control" @bind-Value="form.PrecioVenta" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Stock *</label>
                        <InputNumber class="form-control" @bind-Value="form.StockActual" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Fecha Expiración</label>
                        <InputDate class="form-control" @bind-Value="form.FechaExpiracion" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i>
                        @(editando ? "Guardar Cambios" : "Guardar Producto")
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Tabla de productos -->
@if (cargando)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Cargando productos...</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped mb-0 align-middle">
                <thead class="text-white" style="background-color:#4a56e2;">
                    <tr class="text-center">
                        <th scope="col">Código</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Precio Unitario</th>
                        <th scope="col">Precio Venta</th>
                        <th scope="col">Stock</th>
                        <th scope="col">Expira</th>
                        <th scope="col" style="width:200px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!productosMostrados.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-3">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                No hay productos para mostrar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in productosMostrados)
                        {
                            <tr>
                                <td>@p.Codigo</td>
                                <td>@p.Nombre</td>
                                <td>@p.Categoria</td>
                                <td class="text-end">@p.PrecioUnitario.ToString("0.00")</td>
                                <td class="text-end">@p.PrecioVenta.ToString("0.00")</td>
                                <td class="text-center">@p.StockActual</td>
                                <td class="text-center">@((p.FechaExpiracion?.ToString("dd/MM/yyyy")) ?? "-")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-info btn-sm text-white"
                                                @onclick="() => Editar(p)">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </button>
                                        @if (p.Estado)
                                        {
                                            <button class="btn btn-warning btn-sm text-white"
                                                    @onclick="() => CambiarEstado(p, false)">
                                                <i class="bi bi-slash-circle"></i> Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-success btn-sm"
                                                    @onclick="() => CambiarEstado(p, true)">
                                                <i class="bi bi-check2-circle"></i> Reactivar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Formulario -->

@code {
    private HttpClient _http => HttpFactory.CreateClient("LocalApi");

    private List<Producto> productos = new();
    private List<Producto> productosActivos => productos.Where(p => p.Estado).ToList();
    private List<Producto> productosInactivos => productos.Where(p => !p.Estado).ToList();
    private IEnumerable<Producto> productosMostrados => mostrarActivos ? productosActivos : productosInactivos;

    private bool mostrarActivos = true;
    private bool cargando = true;
    private bool mostrarForm = false;
    private bool editando = false;

    private Producto form = new();
    private EditContext EditContext = default!;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            var data = await _http.GetFromJsonAsync<List<Producto>>("api/productos");
            productos = data ?? new();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void CambiarVista(bool activos)
    {
        mostrarActivos = activos;
        mostrarForm = false;
    }

    private void Nuevo()
    {
        form = new Producto { Estado = true };
        EditContext = new EditContext(form);
        editando = false;
        mostrarForm = true;
    }

    private void Editar(Producto p)
    {
        form = new Producto
        {
            IdProducto = p.IdProducto,
            Codigo = p.Codigo,
            Nombre = p.Nombre,
            Categoria = p.Categoria,
            PrecioUnitario = p.PrecioUnitario,
            PrecioVenta = p.PrecioVenta,
            StockActual = p.StockActual,
            FechaExpiracion = p.FechaExpiracion,
            Estado = p.Estado
        };
        EditContext = new EditContext(form);
        editando = true;
        mostrarForm = true;
    }

    private async Task Guardar()
    {
        HttpResponseMessage resp = editando
            ? await _http.PutAsJsonAsync($"api/productos/{form.IdProducto}", form)
            : await _http.PostAsJsonAsync("api/productos", form);

        if (resp.IsSuccessStatusCode)
        {
            await Cargar();
            mostrarForm = false;
        }
    }

    private void Cancelar()
    {
        mostrarForm = false;
        editando = false;
    }

    private async Task CambiarEstado(Producto p, bool nuevoEstado)
    {
        p.Estado = nuevoEstado;
        await _http.PutAsJsonAsync($"api/productos/{p.IdProducto}", p);
        await Cargar();
    }
}
