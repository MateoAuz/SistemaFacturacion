@page "/productos"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using SistemaFacturacion.Domain.Entities
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS

<!-- ENCABEZADO PRINCIPAL -->
<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-box-seam"></i> Gestión de Productos</h1>
</div>

<!-- 🔔 NOTIFICACIONES -->
@if (mostrarMensaje)
{
    <div class="alert alert-@tipoMensaje-custom text-center fade-in">
        @mensaje
    </div>
}

<!-- TABS ACTIVOS / INACTIVOS -->
<div class="tabs-container d-flex align-items-center mb-3">
    <button class="tab-btn @(mostrarActivos ? "active" : "") me-2" @onclick="() => CambiarVista(true)">
        <i class="bi bi-boxes"></i> Productos Activos
        <span class="badge-count">@productosActivos.Count</span>
    </button>

    <button class="tab-btn @(mostrarActivos ? "" : "active")" @onclick="() => CambiarVista(false)">
        <i class="bi bi-archive"></i> Productos Inactivos
        <span class="badge-count">@productosInactivos.Count</span>
    </button>
</div>

<!-- BOTÓN NUEVO -->
@if (mostrarActivos)
{
    <button class="btn btn-primary btn-new mb-3" @onclick="Nuevo">
        <i class="bi bi-plus-circle"></i> Nuevo Producto
    </button>
}

@if (mostrarForm)
{
    <div class="card mt-4 border-0 shadow-sm">
        <div class="card-header text-white fw-bold"
            style="background-color:#4a56e2; border-top-left-radius:12px; border-top-right-radius:12px;">
            <i class="bi bi-journal-plus me-2"></i>
            @(editando ? "Editar Producto" : "Nuevo Producto")
        </div>

        <div class="card-body">
            <EditForm EditContext="@EditContext" OnValidSubmit="@Guardar">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <!-- CÓDIGO -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-upc-scan me-1 text-primary"></i> Código *
                        </label>
                        @if (editando)
                        {
                            <!-- En modo edición: campo deshabilitado -->
                            <InputText class="form-control" 
                                    @bind-Value="form.Codigo" 
                                    disabled
                                    placeholder="Ej. PUR001" />
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> El código no se puede modificar en edición
                            </small>
                        }
                        else
                        {
                            <!-- En modo nuevo: campo habilitado con validación -->
                            <InputText class="form-control" 
                                    @bind-Value="form.Codigo" 
                                    @oninput="async () => await ValidarCodigoUnico()"
                                    placeholder="Ej. PUR001" />
                            <ValidationMessage For="@(() => form.Codigo)" />
                            @if (codigoDuplicado)
                            {
                                <div class="text-danger small mt-1">
                                    <i class="bi bi-exclamation-triangle"></i> Este código ya existe
                                </div>
                            }
                        }
                    </div>

                    <!-- NOMBRE -->
                    <div class="col-md-5">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-box-seam me-1 text-primary"></i> Nombre *
                        </label>
                        <InputText class="form-control" @bind-Value="form.Nombre"
                            placeholder="Ej. Purina Pro Plan Adulto" />
                        <ValidationMessage For="@(() => form.Nombre)" />
                    </div>

                    <!-- CATEGORÍA -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-tags me-1 text-primary"></i> Categoría
                        </label>
                        <InputSelect class="form-select" @bind-Value="form.Categoria" @onchange="OnCategoriaChanged">
                            <option value="">Seleccione una categoría</option>
                            @foreach (var categoria in categorias)
                            {
                                <option value="@categoria">@categoria</option>
                            }
                        </InputSelect>
                        <small class="text-muted">Seleccione una categoría de la lista</small>
                    </div>

                    <!-- PRECIO UNITARIO -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-cash-coin me-1 text-primary"></i> Precio Unitario *
                        </label>
                        <InputNumber class="form-control" @bind-Value="form.PrecioUnitario" 
                                @oninput="ValidarPrecios"
                                placeholder="0.00" />
                        <ValidationMessage For="@(() => form.PrecioUnitario)" />
                    </div>

                    <!-- PRECIO VENTA -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-cart-check me-1 text-primary"></i> Precio Venta *
                        </label>
                        <InputNumber class="form-control" @bind-Value="form.PrecioVenta" 
                                @oninput="ValidarPrecios"
                                placeholder="0.00" />
                        <ValidationMessage For="@(() => form.PrecioVenta)" />
                    </div>

                    <!-- STOCK -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-box2 me-1 text-primary"></i> Stock *
                        </label>
                        <InputNumber class="form-control" @bind-Value="form.StockActual" placeholder="Ej. 50" />
                        <ValidationMessage For="@(() => form.StockActual)" />
                    </div>

                    <!-- FECHA EXPIRACIÓN - CONDICIONAL -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-event me-1 text-primary"></i> Fecha Expiración
                        </label>
                        @if (RequiereFechaExpiracion(form.Categoria))
                        {
                            <InputDate class="form-control" @bind-Value="form.FechaExpiracion" />
                            <small class="text-muted">Productos perecederos requieren fecha de expiración</small>
                        }
                        else
                        {
                            <InputDate class="form-control" @bind-Value="form.FechaExpiracion" disabled />
                            <small class="text-muted">No requerido para esta categoría</small>
                            <!-- Limpiar fecha si no es requerida -->
                            @if (form.FechaExpiracion.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary mt-1" 
                                        @onclick="() => form.FechaExpiracion = null">
                                    <i class="bi bi-x-circle"></i> Limpiar fecha
                                </button>
                            }
                        }
                    </div>
                </div>

                <!-- ALERTA DE PRECIOS -->
                @if (form.PrecioVenta < form.PrecioUnitario && form.PrecioUnitario > 0)
                {
                    <div class="alert alert-warning mt-3">
                        <i class="bi bi-exclamation-triangle"></i>
                        El precio de venta es menor al precio unitario. Esto podría generar pérdidas.
                    </div>
                }

                <!-- BOTONES -->
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success px-3" disabled="@(codigoDuplicado && !editando)">
                        <i class="bi bi-check-circle"></i>
                        @(editando ? "Guardar Cambios" : "Guardar Producto")
                    </button>
                    <button type="button" class="btn btn-secondary px-3" @onclick="Cancelar">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Tabla de productos -->
@if (cargando)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Cargando productos...</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped mb-0 align-middle">
                <thead class="text-white" style="background-color:#4a56e2;">
                    <tr class="text-center">
                        <th scope="col">Código</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Precio Unitario</th>
                        <th scope="col">Precio Venta</th>
                        <th scope="col">Stock</th>
                        <th scope="col">Expira</th>
                        <th scope="col" style="width:200px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!productosMostrados.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-3">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                No hay productos para mostrar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in productosMostrados)
                        {
                            <tr>
                                <td>@p.Codigo</td>
                                <td>@p.Nombre</td>
                                <td>
                                    <span class="badge bg-secondary">@p.Categoria</span>
                                </td>
                                <td class="text-end">@p.PrecioUnitario.ToString("C2")</td>
                                <td class="text-end">@p.PrecioVenta.ToString("C2")</td>
                                <td class="text-center">
                                    <span class="badge @(p.StockActual <= 5 ? "bg-warning" : "bg-success")">
                                        @p.StockActual
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (p.FechaExpiracion.HasValue)
                                    {
                                        <span class="badge @(p.FechaExpiracion.Value < DateTime.Now.AddDays(30) ? "bg-danger" : "bg-info")">
                                            @p.FechaExpiracion?.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        @if (p.Estado)
                                        {
                                            <button class="btn-action btn-edit" @onclick="() => Editar(p)">
                                                <i class="bi bi-pencil"></i> Editar
                                            </button>

                                            <button class="btn-action btn-disable" @onclick="() => CambiarEstado(p, false)">
                                                <i class="bi bi-person-dash"></i> Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-action btn-enable" @onclick="() => CambiarEstado(p, true)">
                                                <i class="bi bi-person-check"></i> Reactivar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private HttpClient _http => HttpFactory.CreateClient("LocalApi");

    private List<Producto> productos = new();
    private List<Producto> productosActivos => productos.Where(p => p.Estado).ToList();
    private List<Producto> productosInactivos => productos.Where(p => !p.Estado).ToList();
    private IEnumerable<Producto> productosMostrados => mostrarActivos ? productosActivos : productosInactivos;

    // Lista de categorías predefinidas
    private List<string> categorias = new()
    {
        "Alimento",
        "Medicamento",
        "Juguete",
        "Accesorio",
        "Higiene",
        "Ropa",
        "Transportadora",
        "Suplemento",
        "Otros"
    };

    // Categorías que requieren fecha de expiración
    private List<string> categoriasConExpiracion = new()
    {
        "Alimento",
        "Medicamento",
        "Suplemento"
    };

    private bool mostrarActivos = true;
    private bool cargando = true;
    private bool mostrarForm = false;
    private bool editando = false;
    private bool codigoDuplicado = false;

    private string? mensaje;
    private string tipoMensaje = "success";
    private bool mostrarMensaje;

    private Producto form = new();
    private EditContext EditContext = default!;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            var data = await _http.GetFromJsonAsync<List<Producto>>("api/productos");
            productos = data ?? new();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void CambiarVista(bool activos)
    {
        mostrarActivos = activos;
        mostrarForm = false;
        codigoDuplicado = false;
    }

    private void Nuevo()
    {
        form = new Producto { Estado = true };
        EditContext = new EditContext(form);
        editando = false;
        mostrarForm = true;
        codigoDuplicado = false;
    }

    private void Editar(Producto p)
    {
        form = new Producto
        {
            IdProducto = p.IdProducto,
            Codigo = p.Codigo,
            Nombre = p.Nombre,
            Categoria = p.Categoria,
            PrecioUnitario = p.PrecioUnitario,
            PrecioVenta = p.PrecioVenta,
            StockActual = p.StockActual,
            FechaExpiracion = p.FechaExpiracion?.Date,
            Estado = p.Estado
        };
        EditContext = new EditContext(form);
        editando = true;
        mostrarForm = true;
        codigoDuplicado = false;
        
        // Validación inicial de precios
        ValidarPrecios();
    }

    private async Task Guardar()
    {
        // ✅ VALIDACIÓN EXTRA: Precio de venta no menor al unitario
        if (form.PrecioVenta < form.PrecioUnitario)
        {
            MostrarMensaje("❌ El precio de venta no puede ser menor al precio unitario", "error");
            return;
        }

        // ✅ VALIDACIÓN EXTRA: Código único para nuevos productos
        if (!editando && codigoDuplicado)
        {
            MostrarMensaje("❌ El código ya existe. Por favor, use un código diferente.", "error");
            return;
        }

        // Si la categoría no requiere fecha de expiración, limpiar el campo
        if (!RequiereFechaExpiracion(form.Categoria))
        {
            form.FechaExpiracion = null;
        }

        HttpResponseMessage resp = editando
            ? await _http.PutAsJsonAsync($"api/productos/{form.IdProducto}", form)
            : await _http.PostAsJsonAsync("api/productos", form);

        if (resp.IsSuccessStatusCode)
        {
            await Cargar();
            mostrarForm = false;
            MostrarMensaje(editando 
                ? "✅ Producto actualizado correctamente" 
                : "🎉 Producto registrado exitosamente", 
                "success");
        }
        else
        {
            var msg = await resp.Content.ReadAsStringAsync();
            MostrarMensaje($"❌ Error al guardar: {msg}", "error");
        }
    }

    private void Cancelar()
    {
        mostrarForm = false;
        editando = false;
        codigoDuplicado = false;
    }

    private async Task CambiarEstado(Producto p, bool activar)
    {
        var endpoint = activar
            ? $"api/productos/{p.IdProducto}/activar"
            : $"api/productos/{p.IdProducto}/desactivar";

        var resp = await _http.PatchAsync(endpoint, null);

        if (resp.IsSuccessStatusCode)
        {
            await Cargar();
            MostrarMensaje(activar 
                ? "✅ Producto reactivado correctamente" 
                : "⚠️ Producto desactivado correctamente", 
                "info");
        }
        else
        {
            var mensajeError = await resp.Content.ReadAsStringAsync();
            MostrarMensaje($"❌ Error al cambiar estado: {mensajeError}", "error");
        }
    }

    // Método para determinar si una categoría requiere fecha de expiración
    private bool RequiereFechaExpiracion(string? categoria)
    {
        if (string.IsNullOrEmpty(categoria))
            return false;

        return categoriasConExpiracion.Contains(categoria, StringComparer.OrdinalIgnoreCase);
    }

    private async Task ValidarCodigoUnico()
    {
        if (!string.IsNullOrWhiteSpace(form.Codigo) && !editando)
        {
            try
            {
                var productoExistente = await _http.GetFromJsonAsync<Producto>($"api/productos/by-codigo/{form.Codigo}");
                if (productoExistente != null)
                {
                    codigoDuplicado = true;
                }
                else
                {
                    codigoDuplicado = false;
                }
            }
            catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // Código no existe - está bien
                codigoDuplicado = false;
            }
            StateHasChanged();
        }
    }

    private void ValidarPrecios()
    {
        // Esta validación se refleja en la alerta que ya tienes en el HTML
        StateHasChanged();
    }

    private void OnCategoriaChanged()
    {
        // Si la categoría cambia y no requiere fecha, limpiar la fecha
        if (!RequiereFechaExpiracion(form.Categoria) && form.FechaExpiracion.HasValue)
        {
            form.FechaExpiracion = null;
        }
        StateHasChanged();
    }

    private void MostrarMensaje(string texto, string tipo = "success")
    {
        mensaje = texto;
        tipoMensaje = tipo;
        mostrarMensaje = true;

        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            mostrarMensaje = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}