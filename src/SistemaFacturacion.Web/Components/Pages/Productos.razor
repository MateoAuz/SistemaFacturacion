        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .tab-btn.active {
        background-color: #4a56e2;
        color: white;
    }

    .tab-btn:not(.active):hover {
        background-color: #f8f9fa;
    }

    .badge-count {
        background-color: #6c757d;
        color: white;
        border-radius: 10px;
        padding: 0.15rem 0.5rem;
        font-size: 0.75rem;
        margin-left: 0.25rem;
    }

    .btn-new {
        background-color: #4a56e2;
        border: none;
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-weight: 600;
    }

    .btn-new:hover {
        background-color: #3a46d2;
        transform: translateY(-1px);
    }

    .fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .alert-success-custom {
        background-color: #d4edda;
        border-color: #c3e6cb;
        color: #155724;
    }

    .alert-error-custom {
        background-color: #f8d7da;
        border-color: #f5c6cb;
        color: #721c24;
    }

    .alert-info-custom {
        background-color: #d1ecf1;
        border-color: #bee5eb;
        color: #0c5460;
    }

    .table th {
        border: none;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35rem 0.65rem;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
    }

    .small {
        font-size: 0.7rem;
    }
</style>