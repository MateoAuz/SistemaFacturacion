@page "/dashboard"
@rendermode InteractiveServer
@using SistemaFacturacion.Domain.Entities
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@using Microsoft.AspNetCore.Components.Authorization


<PageTitle>Dashboard Principal</PageTitle>

<div class="fade-in">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="mb-0 text-white fw-bold"><i class="bi bi-speedometer2"></i> Panel de Control</h1>
                <p class="text-white-50 mb-0">Resumen general del negocio</p>
            </div>
            <div class="text-white text-end d-none d-md-block">
                <h5 class="mb-0 fecha">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</h5>
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Calculando estadísticas...</p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 overflow-hidden">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success me-3">
                                <i class="bi bi-cash-coin fs-1"></i>
                            </div>
                            <div>
                                <h6 class="card-subtitle text-muted mb-1">Ventas del Día</h6>
                                <h3 class="card-title mb-0 fw-bold text-dark">$@ingresosHoy.ToString("N2")</h3>
                                <small class="text-success fw-bold">
                                    <i class="bi bi-receipt"></i> @facturasHoy facturas
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-success bg-opacity-10 border-0 py-1 px-3">
                        <a href="/ventas" class="text-success text-decoration-none small fw-bold stretched-link">Nueva Venta
                            <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 overflow-hidden">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning me-3">
                                <i class="bi bi-exclamation-triangle fs-1"></i>
                            </div>
                            <div>
                                <h6 class="card-subtitle text-muted mb-1">Stock Bajo</h6>
                                <h3 class="card-title mb-0 fw-bold text-dark">@productosBajoStock</h3>
                                <small class="text-danger fw-bold">
                                    @productosSinStock agotados
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-warning bg-opacity-10 border-0 py-1 px-3">
                        <a href="/productos" class="text-warning text-decoration-none small fw-bold stretched-link">Ver
                            Inventario <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 overflow-hidden">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary me-3">
                                <i class="bi bi-people fs-1"></i>
                            </div>
                            <div>
                                <h6 class="card-subtitle text-muted mb-1">Clientes</h6>
                                <h3 class="card-title mb-0 fw-bold text-dark">@totalClientes</h3>
                                <small class="text-primary">
                                    Activos en el sistema
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-primary bg-opacity-10 border-0 py-1 px-3">
                        <a href="/clientes" class="text-primary text-decoration-none small fw-bold stretched-link">Gestionar
                            <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 overflow-hidden">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle p-3 bg-info bg-opacity-10 text-info me-3">
                                <i class="bi bi-box-seam fs-1"></i>
                            </div>
                            <div>
                                <h6 class="card-subtitle text-muted mb-1">Productos</h6>
                                <h3 class="card-title mb-0 fw-bold text-dark">@totalProductos</h3>
                                <small class="text-muted">
                                    Registrados
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-info bg-opacity-10 border-0 py-1 px-3">
                        <a href="/productos" class="text-info text-decoration-none small fw-bold stretched-link">Ver
                            Catálogo <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card card-modern h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h5 class="fw-bold mb-0"><i class="bi bi-lightning-charge text-warning"></i> Acciones Rápidas</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="d-grid gap-3">
                            <a href="/ventas"
                                class="btn btn-outline-primary btn-lg text-start p-3 border-2 d-flex align-items-center shadow-sm-hover">
                                <div class="bg-primary text-white rounded-circle p-2 me-3"><i
                                        class="bi bi-cart-plus fs-4"></i></div>
                                <div>
                                    <div class="fw-bold">Nueva Venta</div>
                                    <div class="small text-muted">Facturar productos a un cliente</div>
                                </div>
                            </a>

                            <div class="row g-3">
                                <div class="col-6">
                                    <a href="/clientes"
                                        class="btn btn-light w-100 p-3 h-100 border text-start shadow-sm-hover">
                                        <i class="bi bi-person-plus fs-4 text-success d-block mb-2"></i>
                                        <span class="fw-bold text-dark">Nuevo Cliente</span>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a href="/productos"
                                        class="btn btn-light w-100 p-3 h-100 border text-start shadow-sm-hover">
                                        <i class="bi bi-box-seam fs-4 text-info d-block mb-2"></i>
                                        <span class="fw-bold text-dark">Inventario</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card card-modern h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h5 class="fw-bold mb-0"><i class="bi bi-building text-secondary"></i> Empresa</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        @if (empresa != null)
                        {
                            <div class="list-group list-group-flush">
                                <div class="list-group-item px-0 py-3">
                                    <small class="text-muted d-block">Razón Social</small>
                                    <strong class="text-dark">@empresa.RazonSocial</strong>
                                </div>
                                <div class="list-group-item px-0 py-3">
                                    <small class="text-muted d-block">RUC</small>
                                    <span class="font-monospace">@empresa.Ruc</span>
                                </div>
                                <div class="list-group-item px-0 py-3">
                                    <small class="text-muted d-block">Ambiente SRI</small>
                                    @if (empresa.Ambiente == '1')
                                    {
                                        <span class="badge bg-warning text-dark">PRUEBAS</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-success">PRODUCCIÓN</span>
                                    }
                                </div>
                            </div>
                            <div class="mt-3 text-end">
                                <a href="/configuracion" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-gear"></i> Configurar
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-exclamation-circle display-4 text-muted mb-3"></i>
                                <p>No se ha configurado la información de la empresa.</p>
                                <a href="/configuracion" class="btn btn-primary">Configurar Ahora</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .shadow-sm-hover {
        transition: all 0.2s;
    }

    .shadow-sm-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
        border-color: transparent;
    }

    .page-header {
        background: linear-gradient(135deg, #4a56e2 0%, #6a11cb 100%);
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(74, 86, 226, 0.2);
    }

    .card-modern {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
    }

    /* Fecha en header: asegurar buen contraste sobre el degradado */
    .page-header .fecha {
        color: #ffffff !important;
        opacity: 0.95;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    }
</style>

@code {
    private HttpClient _http => HttpFactory.CreateClient("LocalApi");

    // Estadísticas
    private decimal ingresosHoy = 0;
    private int facturasHoy = 0;
    private int productosBajoStock = 0;
    private int productosSinStock = 0;
    private int totalClientes = 0;
    private int totalProductos = 0;

    private ConfiguracionEmpresa? empresa;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();

        if (state.User?.Identity is null || !state.User.Identity.IsAuthenticated)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            var tasks = new List<Task> { CargarVentas(), CargarInventario(), CargarClientes(), CargarEmpresa() };
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando dashboard: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarVentas()
    {
        try
        {
            var facturas = await _http.GetFromJsonAsync<List<Factura>>("api/facturas") ?? new();
            var hoy = DateTime.Today;
            var ventasHoy = facturas.Where(f => f.FechaEmision.Date == hoy && f.Estado != "ANULADA").ToList();

            ingresosHoy = ventasHoy.Sum(f => f.Total);
            facturasHoy = ventasHoy.Count;
        }
        catch { }
    }

    private async Task CargarInventario()
    {
        try
        {
            var productos = await _http.GetFromJsonAsync<List<Producto>>("api/productos?includeLotes=true") ?? new();
            totalProductos = productos.Count;
            productosBajoStock = productos.Count(p => p.StockTotal > 0 && p.StockTotal <= 5);
            productosSinStock = productos.Count(p => p.StockTotal == 0);
        }
        catch { }
    }

    private async Task CargarClientes()
    {
        try
        {
            var clientes = await _http.GetFromJsonAsync<List<Cliente>>("api/clientes") ?? new();
            totalClientes = clientes.Count(c => c.Estado);
        }
        catch { }
    }

    private async Task CargarEmpresa()
    {
        try
        {
            empresa = await _http.GetFromJsonAsync<ConfiguracionEmpresa>("api/configuracion");
        }
        catch { }
    }
}