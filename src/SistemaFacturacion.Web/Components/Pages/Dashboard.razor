@page "/dashboard"
@rendermode InteractiveServer
@using SistemaFacturacion.Domain.Entities
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

<div class="dashboard-page">
    <!-- Welcome Header -->
    <div class="page-header">
        <h1 class="mb-0 text-white"><i class="bi bi-house-door"></i> PetMarket Ecuador S.A</h1>
    
    </div>

    <!-- Stats Overview -->
    <div class="stats-grid">
        <!-- CLIENTES -->
        <div class="dashboard-card">
            <div class="card-icon primary">
                <i class="bi bi-people"></i>
            </div>
            <div class="card-value">@totalClientes</div>
            <div class="card-label">Clientes Activos</div>
            <div class="mt-2">
                <small class="text-success">
                    <i class="bi bi-check-circle"></i>
                    @clientesActivos activos
                </small>
            </div>
        </div>

        <!-- PRODUCTOS -->
        <div class="dashboard-card">
            <div class="card-icon success">
                <i class="bi bi-box-seam"></i>
            </div>
            @if (cargando)
            {
                <div class="d-flex justify-content-center align-items-center" style="height: 80px;">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            }
            else
            {
                <div class="card-value">@totalProductos</div>
            }
            <div class="card-label">Productos en Stock</div>
            <div class="mt-2">
                <small class="text-info">
                    <i class="bi bi-inbox"></i>
                    @productosBajoStock en stock bajo
                </small>
            </div>
        </div>

        <!-- FACTURAS -->
        <div class="dashboard-card">
            <div class="card-icon warning">
                <i class="bi bi-receipt"></i>
            </div>
            <div class="card-value">@totalFacturasMes</div>
            <div class="card-label">Facturas Este Mes</div>
            <div class="mt-2">
                <small class="text-warning">
                    <i class="bi bi-graph-up"></i>
                    @facturasHoy hoy
                </small>
            </div>
        </div>

        <!-- INGRESOS -->
        <div class="dashboard-card">
            <div class="card-icon info">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <div class="card-value">$@ingresosMes.ToString("N2")</div>
            <div class="card-label">Ingresos del Mes</div>
            <div class="mt-2">
                <small class="text-success">
                    <i class="bi bi-cash-coin"></i>
                    $@ingresosHoy.ToString("N2") hoy
                </small>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <h5 class="mb-3">Acciones Rápidas</h5>
            <div class="quick-actions">
                <a href="/clientes" class="action-btn">
                    <i class="bi bi-person-plus"></i>
                    <div>
                        <strong>Nuevo Cliente</strong>
                        <small class="d-block">Agregar cliente al sistema</small>
                    </div>
                </a>
                <a href="/productos" class="action-btn">
                    <i class="bi bi-plus-square"></i>
                    <div>
                        <strong>Nuevo Producto</strong>
                        <small class="d-block">Agregar producto al inventario</small>
                    </div>
                </a>
                <a href="/ventas" class="action-btn">
                    <i class="bi bi-file-earmark-plus"></i>
                    <div>
                        <strong>Nueva Factura</strong>
                        <small class="d-block">Crear factura de venta</small>
                    </div>
                </a>
                <a href="/reportes" class="action-btn">
                    <i class="bi bi-graph-up"></i>
                    <div>
                        <strong>Ver Reportes</strong>
                        <small class="d-block">Análisis y estadísticas</small>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Company Info & Resumen de Ventas -->
    <div class="row">
        <!-- Company Information -->
        <div class="col-md-6 mb-4">
            <div class="dashboard-card">
                <h5 class="mb-3">
                    <i class="bi bi-building me-2"></i>Información de la Empresa
                </h5>
                <div class="company-info">
                    @if (empresa != null)
                    {
                        <div class="info-item mb-3">
                            <strong><i class="bi bi-building me-2"></i>Razón Social:</strong>
                            <span class="ms-2">@empresa.RazonSocial</span>
                        </div>
                        <div class="info-item mb-3">
                            <strong><i class="bi bi-shop me-2"></i>Nombre Comercial:</strong>
                            <span class="ms-2">@empresa.NombreComercial</span>
                        </div>
                        <div class="info-item mb-3">
                            <strong><i class="bi bi-geo-alt me-2"></i>Dirección:</strong>
                            <span class="ms-2">@empresa.DireccionMatriz</span>
                        </div>
                        <div class="info-item mb-3">
                            <strong><i class="bi bi-envelope me-2"></i>Email:</strong>
                            <span class="ms-2">@empresa.CorreoEmpresa</span>
                        </div>
                        <div class="info-item">
                            <strong><i class="bi bi-file-text me-2"></i>RUC:</strong>
                            <span class="ms-2">@empresa.Ruc</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-exclamation-triangle display-6"></i>
                            <p class="mt-2">No hay configuración de empresa</p>
                            <a href="/configuracion" class="btn btn-primary btn-sm mt-2">Configurar Empresa</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Resumen de Ventas -->
        <div class="col-md-6 mb-4">
            <div class="dashboard-card">
                <h5 class="mb-3">
                    <i class="bi bi-graph-up me-2"></i>Resumen de Ventas
                </h5>
                <div class="system-status">
                    <div class="status-item mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Promedio por Factura</span>
                            <span class="badge bg-info">$@ticketPromedio.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="status-item mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Facturas Pendientes</span>
                            <span class="badge bg-warning">@facturasPendientes</span>
                        </div>
                    </div>
                    <div class="status-item mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Productos Sin Stock</span>
                            <span class="badge bg-danger">@productosSinStock</span>
                        </div>
                    </div>
                    <div class="status-item mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Clientes Nuevos (Mes)</span>
                            <span class="badge bg-success">@clientesNuevosMes</span>
                        </div>
                    </div>
                    <div class="status-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Tasa de Conversión</span>
                            <span class="badge bg-primary">@tasaConversion%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row">
        <div class="col-12">
            <div class="dashboard-card">
                <h5 class="mb-3">
                    <i class="bi bi-clock-history me-2"></i>Actividad Reciente
                </h5>
                <div class="recent-activity">
                    @if (actividadReciente.Any())
                    {
                        foreach (var actividad in actividadReciente.Take(5))
                        {
                            <div class="activity-item mb-3 p-3 border rounded">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <i class="bi @actividad.Icono me-2 text-primary"></i>
                                        <strong>@actividad.Titulo</strong>
                                        <p class="mb-0 text-muted small">@actividad.Descripcion</p>
                                    </div>
                                    <small class="text-muted">@actividad.Tiempo</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox display-4 d-block mb-2"></i>
                            <p>No hay actividad reciente</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private HttpClient _http => HttpFactory.CreateClient("LocalApi");

    // Datos principales (existentes)
    private int totalClientes = 0;
    private int clientesActivos = 0;
    private int totalProductos = 0;
    private int totalFacturasMes = 0;
    private decimal ingresosMes = 0;
    private int facturasHoy = 0;
    private decimal ingresosHoy = 0;
    private int productosBajoStock = 0;

    // Nuevas métricas para Resumen de Ventas
    private int facturasPendientes = 0;
    private int productosSinStock = 0;
    private int clientesNuevosMes = 0;
    private int tasaConversion = 75; // Valor por defecto, se calculará después
    private int productosVendidosMes = 0;
    private decimal ticketPromedio = 0;

    // Configuración
    private ConfiguracionEmpresa? empresa;
    private bool cargando = true;

    // Actividad
    private List<Actividad> actividadReciente = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosDashboard();
    }

    private async Task CargarDatosDashboard()
    {
        try
        {
            cargando = true;

            // Cargar datos en paralelo para mejor performance
            var tasks = new List<Task>
{
CargarClientes(),
CargarProductos(),
CargarFacturas(),
CargarConfiguracionEmpresa(),
CargarActividadReciente()
};

            await Task.WhenAll(tasks);

            // Calcular métricas derivadas después de cargar todos los datos
            CalcularMetricasAdicionales();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando dashboard: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarClientes()
    {
        try
        {
            var clientes = await _http.GetFromJsonAsync<List<Cliente>>("api/clientes");
            totalClientes = clientes?.Count ?? 0;

            // Clientes activos (estado = true)
            clientesActivos = clientes?.Count(c => c.Estado) ?? 0;

            // Clientes nuevos del mes (aproximación - si no hay fecha, contamos todos como base)
            clientesNuevosMes = totalClientes > 5 ? 3 : totalClientes; // Demo hasta que tengas fecha
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando clientes: {ex.Message}");
        }
    }

    private async Task CargarProductos()
    {
        try
        {
            var productos = await _http.GetFromJsonAsync<List<Producto>>("api/productos");
            totalProductos = productos?.Count ?? 0;

            // Productos con stock bajo (menos de 10 unidades)
            productosBajoStock = productos?.Count(p => p.StockTotal < 10) ?? 0;
            productosSinStock = productos?.Count(p => p.StockTotal == 0) ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando productos: {ex.Message}");
        }
    }

    private async Task CargarFacturas()
    {
        try
        {
            var facturas = await _http.GetFromJsonAsync<List<Factura>>("api/facturas");
            var hoy = DateTime.Today;
            var inicioMes = new DateTime(hoy.Year, hoy.Month, 1);

            var facturasDelMes = facturas?.Where(f => f.FechaEmision >= inicioMes).ToList() ?? new();

            totalFacturasMes = facturasDelMes.Count;
            facturasHoy = facturasDelMes.Count(f => f.FechaEmision.Date == hoy);
            ingresosMes = facturasDelMes.Sum(f => f.Total);
            ingresosHoy = facturasDelMes.Where(f => f.FechaEmision.Date == hoy).Sum(f => f.Total);

            // Facturas pendientes
            facturasPendientes = facturas?.Count(f => f.Estado == "PENDIENTE") ?? 0;

            // Calcular productos vendidos este mes
            await CalcularProductosVendidosMes();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando facturas: {ex.Message}");
        }
    }

    private async Task CalcularProductosVendidosMes()
    {
        try
        {
            var hoy = DateTime.Today;
            var inicioMes = new DateTime(hoy.Year, hoy.Month, 1);

            // Obtener detalles de facturas del mes
            var detalles = await _http.GetFromJsonAsync<List<DetalleFactura>>("api/facturas/detalles-mes");
            productosVendidosMes = detalles?.Sum(d => d.Cantidad) ?? (totalFacturasMes * 3); // Estimación
        }
        catch (Exception ex)
        {
            // Si no existe el endpoint, hacemos una estimación
            productosVendidosMes = totalFacturasMes * 3; // Estimación: 3 productos por factura
            Console.WriteLine($"Usando estimación para productos vendidos: {ex.Message}");
        }
    }

    private void CalcularMetricasAdicionales()
    {
        // Ticket promedio
        ticketPromedio = totalFacturasMes > 0 ? ingresosMes / totalFacturasMes : 0;

        // Tasa de conversión (estimada basada en facturas vs clientes)
        if (totalClientes > 0 && totalFacturasMes > 0)
        {
            tasaConversion = Math.Min(100, (totalFacturasMes * 100) / totalClientes);
        }
    }

    private async Task CargarConfiguracionEmpresa()
    {
        try
        {
            empresa = await _http.GetFromJsonAsync<ConfiguracionEmpresa>("api/configuracion");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando configuración: {ex.Message}");
        }
    }

    private async Task CargarActividadReciente()
    {
        try
        {
            // Cargar facturas recientes para actividad
            var facturasRecientes = await _http.GetFromJsonAsync<List<Factura>>("api/facturas");

            actividadReciente = new List<Actividad>();

            // Agregar facturas recientes (últimas 5)
            if (facturasRecientes != null && facturasRecientes.Any())
            {
                foreach (var factura in facturasRecientes.OrderByDescending(f => f.FechaEmision).Take(3))
                {
                    actividadReciente.Add(new Actividad
                    {
                        Icono = "bi-receipt",
                        Titulo = "Factura Generada",
                        Descripcion = $"Factura {factura.NumeroFactura} - ${factura.Total:N2}",
                        Tiempo = CalcularTiempoRelativo(factura.FechaEmision)
                    });
                }
            }

            // Si no hay suficiente actividad, agregamos algunas de demo
            if (actividadReciente.Count < 3)
            {
                actividadReciente.AddRange(new[]
                {
new Actividad {
Icono = "bi-system",
Titulo = "Sistema Inicializado",
Descripcion = "Dashboard cargado correctamente",
Tiempo = "Hace un momento"
},
new Actividad {
Icono = "bi-database",
Titulo = "Base de Datos Conectada",
Descripcion = "Conexión establecida con PostgreSQL",
Tiempo = "Hace 2 minutos"
}
});
            }

            // Ordenar por fecha más reciente
            actividadReciente = actividadReciente
            .OrderByDescending(a => a.Tiempo)
            .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando actividad: {ex.Message}");
            GenerarActividadDemo();
        }
    }

    private string CalcularTiempoRelativo(DateTime fecha)
    {
        var diferencia = DateTime.Now - fecha;

        if (diferencia.TotalMinutes < 1) return "Hace un momento";
        if (diferencia.TotalHours < 1) return $"Hace {(int)diferencia.TotalMinutes} min";
        if (diferencia.TotalDays < 1) return $"Hace {(int)diferencia.TotalHours} h";
        if (diferencia.TotalDays < 7) return $"Hace {(int)diferencia.TotalDays} días";

        return fecha.ToString("dd/MM/yyyy");
    }

    private void GenerarActividadDemo()
    {
        actividadReciente = new()
{
new Actividad {
Icono = "bi-system",
Titulo = "Sistema Inicializado",
Descripcion = "Dashboard cargado correctamente",
Tiempo = "Hace un momento"
}
};
    }

    // Clases de apoyo
    private class Actividad
    {
        public string Icono { get; set; } = string.Empty;
        public string Titulo { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public string Tiempo { get; set; } = string.Empty;
    }

    public class Cliente
    {
        public int IdCliente { get; set; }
        public string TipoIdentificacion { get; set; } = string.Empty;
        public string Identificacion { get; set; } = string.Empty;
        public string Nombres { get; set; } = string.Empty;
        public string Apellidos { get; set; } = string.Empty;
        public string Direccion { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public bool Estado { get; set; } = true;
    }

    public class Producto
    {
        public int IdProducto { get; set; }
        public string Codigo { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Categoria { get; set; } = string.Empty;
        public decimal PrecioUnitario { get; set; }
        public decimal PrecioVenta { get; set; }
        public int StockTotal { get; set; } = 0;
        public DateTime? FechaExpiracion { get; set; }
        public bool Estado { get; set; } = true;
    }

    public class Factura
    {
        public int IdFactura { get; set; }
        public string NumeroFactura { get; set; } = string.Empty;
        public int IdCliente { get; set; }
        public int IdUsuario { get; set; }
        public DateTime FechaEmision { get; set; }
        public decimal Subtotal { get; set; }
        public decimal Iva { get; set; }
        public decimal Total { get; set; }
        public string Estado { get; set; } = "PENDIENTE";
    }

    public class DetalleFactura
    {
        public int IdDetalle { get; set; }
        public int IdFactura { get; set; }
        public int IdProducto { get; set; }
        public int Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal TotalLinea { get; set; }
    }
}