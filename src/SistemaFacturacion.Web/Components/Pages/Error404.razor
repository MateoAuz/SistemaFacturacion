@page "/error-404"
@rendermode InteractiveServer

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="text-center">
        <div class="error-icon mb-4">
            <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 5rem;"></i>
        </div>
        
        <h1 class="display-1 fw-bold text-muted">404</h1>
        <h2 class="mb-4 text-dark">Página No Encontrada</h2>
        
        <p class="lead text-muted mb-4">
            Lo sentimos, la página que estás buscando no existe o ha sido movida.
        </p>
        
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <button class="btn btn-primary btn-lg" @onclick="VolverInicio">
                <i class="bi bi-house-door"></i> Volver al Inicio
            </button>
            
            <button class="btn btn-outline-secondary btn-lg" @onclick="VolverAtras">
                <i class="bi bi-arrow-left"></i> Volver Atrás
            </button>
            
            <a href="/clientes" class="btn btn-success btn-lg">
                <i class="bi bi-people"></i> Ir a Clientes
            </a>
        </div>

        <div class="mt-5">
            <small class="text-muted">
                Si crees que esto es un error, contacta al administrador del sistema.
            </small>
        </div>
    </div>
</div>

@code {
    private void VolverInicio()
    {
        Nav.NavigateTo("/");
    }

    private void VolverAtras()
    {
        // Intenta volver atrás en el historial
        JS.InvokeVoidAsync("history.back");
    }

    [Inject] private NavigationManager Nav { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
}

