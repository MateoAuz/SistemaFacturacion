@page "/facturacion"
@rendermode InteractiveServer
@using SistemaFacturacion.Application.DTOs
@using SistemaFacturacion.Application.Contracts
@inject IFacturacionElectronicaService FacturacionService
@inject IJSRuntime JS

<PageTitle>Facturación Electrónica</PageTitle>

<!-- ENCABEZADO PRINCIPAL -->
<div class="page-header">
    <h1 class="mb-0"><i class="bi bi-receipt"></i> Facturación Electrónica - Envío al SRI</h1>
</div>

<!-- NOTIFICACIONES -->
@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success-custom text-center fade-in">
        @mensajeExito
    </div>
}

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-error-custom text-center fade-in">
        @mensajeError
    </div>
}

<!-- FILTROS DE ESTADO Y BUSCADOR -->
@if (!isLoading)
{
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <!-- Filtros de estado (izquierda) -->
                <div class="tabs-container d-flex flex-wrap align-items-center">
                    @foreach (var estado in EstadosSri)
                    {
                        <button class="tab-btn @(filtroEstado == estado.Key ? "active" : "")" data-estado="@estado.Key"
                            @onclick="() => AplicarFiltro(estado.Key)">
                            <i class="bi @estado.Value.Icon"></i>
                            <span>@estado.Value.Label</span>
                            <span class="badge-count">@GetFacturaCountByState(estado.Key)</span>
                        </button>
                    }
                </div>

                <!-- Buscador (derecha) -->
                <div class="search-container">
                    <div class="input-group" style="width: 300px;">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control" placeholder="Buscar por N° factura o cliente..."
                            @bind-value="terminoBusqueda" @bind-value:event="oninput" />
                        @if (!string.IsNullOrEmpty(terminoBusqueda))
                        {
                            <button class="btn btn-outline-secondary" @onclick="LimpiarBusqueda" type="button">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
}


@if (isLoading)
{
    <div class="text-center py-4">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Cargando facturas...</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped mb-0 align-middle">
                <thead class="text-white" style="background-color:#4a56e2;">
                    <tr class="text-center">
                        <th scope="col">N° Factura</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Total</th>
                        <th scope="col">Estado SRI</th>
                        <th scope="col">XML Firmado</th>
                        <th scope="col" style="width:320px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (facturasFiltradas.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-3">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                No hay facturas @(filtroEstado != "TODAS" ? $"con estado                      '{EstadosSri.GetValueOrDefault(filtroEstado).Label}'" : "disponibles para envío")
                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var factura in facturasPaginadas)
                        {
                            <tr>
                                <td class="fw-bold">@factura.NumeroFactura</td>
                                <td>@factura.NombreCliente</td>
                                <td>@factura.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-bold">$@factura.Total.ToString("N2")</td>
                                <td class="text-center">
                                    @if (factura.EstadoEnvio == "GENERADO")
                                    {
                                        <span class="badge bg-secondary">Sin Firmar</span>
                                    }
                                    else if (factura.EstadoEnvio == "FIRMADO")
                                    {
                                        <span class="badge bg-info">Firmado</span>
                                    }
                                    else if (factura.EstadoEnvio == "ENVIADO")
                                    {
                                        <span class="badge bg-warning">Enviado</span>
                                    }
                                    else if (factura.EstadoEnvio == "AUTORIZADO")
                                    {
                                        <span class="badge bg-success">Autorizado</span>
                                    }
                                    else if (factura.EstadoEnvio == "RECHAZADO" || factura.EstadoEnvio == "ERROR_ENVIO")
                                    {
                                        <span class="badge bg-danger">Rechazado/Error</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">@factura.EstadoEnvio</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (factura.TieneXmlFirmado)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Subido
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-x-circle"></i> Pendiente
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                        @* 1. Subir XML (primera vez) *@
                                        @if (!factura.TieneXmlFirmado || factura.EstadoEnvio == "GENERADO")
                                        {
                                            <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => MostrarModalSubirXml(factura)" title="Subir XML Firmado">
                                                <i class="bi bi-upload"></i> Subir XML
                                            </button>
                                        }

                                        @* 2. Reemplazar XML (si fue rechazado) *@
                                        @if (factura.EstadoEnvio == "RECHAZADO" || factura.EstadoEnvio == "ERROR_ENVIO")
                                        {
                                            <button class="btn btn-sm btn-outline-warning"
                                                @onclick="() => MostrarModalSubirXml(factura)" title="Reemplazar XML Rechazado">
                                                <i class="bi bi-arrow-repeat"></i> Corregir XML
                                            </button>
                                        }

                                        @* 3. Enviar al SRI *@
                                        @if (factura.TieneXmlFirmado && (factura.EstadoEnvio == "FIRMADO" || factura.EstadoEnvio ==
                                                                    "ERROR_ENVIO"))
                                        {
                                            <button class="btn btn-sm btn-outline-success"
                                                @onclick="() => EnviarAlSri(factura.IdFactura)" disabled="@procesando"
                                                title="Enviar al SRI">
                                                <i class="bi bi-send"></i> Enviar SRI
                                            </button>
                                        }

                                        @* 4. Consultar Autorización *@
                                        @if (factura.EstadoEnvio == "ENVIADO")
                                        {
                                            <button class="btn btn-sm btn-outline-info"
                                                @onclick="() => ConsultarAutorizacion(factura.IdFactura)" disabled="@procesando"
                                                title="Consultar Autorización">
                                                <i class="bi bi-search"></i> Consultar
                                            </button>
                                        }

                                        @* 5. Generar PDF y enviar correo *@
                                        @if (factura.EstadoEnvio == "AUTORIZADO")
                                        {
                                            <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DescargarYEnviarRide(factura.IdFactura)" disabled="@procesando"
                                                title="Generar PDF y enviar por email">
                                                <i class="bi bi-file-pdf"></i> PDF + Email
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <!-- ✅ AGREGAR PAGINADOR AQUÍ -->
            @if (facturasFiltradas.Any())
            {
                <Paginador TItem="FacturaElectronicaDto" TodosLosItems="facturasFiltradas" ItemsPorPagina="8"
                    OnCambioPagina="ActualizarFacturasPaginadas" />
            }

        </div>
    </div>
}

<!-- ✅ Modal para subir/reemplazar XML firmado -->
@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="background-color: @(esReemplazo ? "#ff9800" : "#4a56e2"); color: white;">
                    <h5 class="modal-title">
                        <i class="bi @(esReemplazo ? "bi-arrow-repeat" : "bi-file-earmark-arrow-up")"></i>
                        @(esReemplazo ? "Reemplazar XML (Corregido)" : "Subir XML Firmado")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (esReemplazo)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Atención:</strong> Este documento fue rechazado. Corrige los errores, firma el nuevo XML, y
                            súbelo aquí.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Instrucciones:</strong> Sube el archivo XML que ha sido firmado digitalmente con FirmaEc.
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccionar archivo XML firmado:</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept=".xml" />
                    </div>

                    @if (!string.IsNullOrEmpty(archivoSeleccionado))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-file-earmark-check"></i> Archivo seleccionado: <strong>@archivoSeleccionado</strong>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        Cancelar
                    </button>
                    <button type="button" class="btn @(esReemplazo ? "btn-warning" : "btn-primary")"
                        @onclick="SubirXmlFirmado" disabled="@(string.IsNullOrEmpty(xmlFirmadoContent) || procesando)">
                        @if (procesando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        <i class="bi @(esReemplazo ? "bi-arrow-repeat" : "bi-upload")"></i>
                        @(esReemplazo ? "Reemplazar" : "Subir XML")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FacturaElectronicaDto> facturas = new();
    private List<FacturaElectronicaDto> facturasPaginadas = new();
    private bool isLoading = true;
    private bool procesando = false;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    private string filtroEstado = "TODAS";

    private string terminoBusqueda = string.Empty;
    private List<FacturaElectronicaDto> facturasFiltradas
    {
        get
        {
            var resultado = facturas.AsEnumerable();

            // Aplicar filtro de estado
            if (filtroEstado != "TODAS")
            {
                if (filtroEstado == "RECHAZADO")
                {
                    resultado = resultado.Where(f =>
                    f.EstadoEnvio == "RECHAZADO" ||
                    f.EstadoEnvio == "ERROR_ENVIO" ||
                    f.EstadoEnvio == "Rechazado/Error"
                    );
                }
                else if (filtroEstado == "NO_ENVIADO")
                {
                    resultado = resultado.Where(f =>
                    f.EstadoEnvio == "NO_ENVIADO" ||
                    f.EstadoEnvio == "GENERADO" ||
                    f.EstadoEnvio == "Sin Firmar"
                    );
                }
                else
                {
                    resultado = resultado.Where(f => f.EstadoEnvio == filtroEstado);
                }
            }

            if (!string.IsNullOrWhiteSpace(terminoBusqueda))
            {
                var busqueda = terminoBusqueda.Trim().ToLower();
                resultado = resultado.Where(f =>
                (f.NumeroFactura != null && f.NumeroFactura.ToLower().Contains(busqueda)) ||
                (f.NombreCliente != null && f.NombreCliente.ToLower().Contains(busqueda))
                );
            }

            return resultado.ToList();
        }
    }

    private bool mostrarModal = false;
    private bool esReemplazo = false;
    private int facturaSeleccionadaId = 0;
    private string archivoSeleccionado = string.Empty;
    private string xmlFirmadoContent = string.Empty;
    private Dictionary<string, (string Label, string Icon)> EstadosSri = new()
{
{"TODAS", ("Todas", "bi-journals")},
{"NO_ENVIADO", ("No Enviado", "bi-file-earmark")},
{"FIRMADO", ("Firmado", "bi-file-earmark-check")},
{"ENVIADO", ("Enviado", "bi-send")},
{"RECHAZADO", ("Rechazado", "bi-x-circle")},
{"AUTORIZADO", ("Autorizado", "bi-check-circle")},
};

    protected override async Task OnInitializedAsync()
    {
        await CargarFacturas();
    }

    private async Task CargarFacturas()
    {
        try
        {
            isLoading = true;
            StateHasChanged();
            facturas = await FacturacionService.GetFacturasParaEnvioAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al cargar facturas: {ex.Message}", false);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private Task ActualizarFacturasPaginadas(List<FacturaElectronicaDto> items)
    {
        facturasPaginadas = items;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void AplicarFiltro(string estado)
    {
        filtroEstado = estado;
        facturasPaginadas = new();
        StateHasChanged();
    }

    private int GetFacturaCountByState(string estado)
    {
        if (estado == "TODAS")
            return facturas.Count;
        if (estado == "RECHAZADO")
            return facturas.Count(f =>
            f.EstadoEnvio == "RECHAZADO" ||
            f.EstadoEnvio == "ERROR_ENVIO" ||
            f.EstadoEnvio == "Rechazado/Error"
            );

        if (estado == "NO_ENVIADO")
            return facturas.Count(f =>
            f.EstadoEnvio == "NO_ENVIADO" ||
            f.EstadoEnvio == "GENERADO" ||
            f.EstadoEnvio == "Sin Firmar"
            );

        return facturas.Count(f => f.EstadoEnvio == estado);
    }


    private void MostrarModalSubirXml(FacturaElectronicaDto factura)
    {
        facturaSeleccionadaId = factura.IdFactura;
        archivoSeleccionado = string.Empty;
        xmlFirmadoContent = string.Empty;
        esReemplazo = factura.EstadoEnvio == "RECHAZADO" || factura.EstadoEnvio == "ERROR_ENVIO";
        mostrarModal = true;
        StateHasChanged();
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        facturaSeleccionadaId = 0;
        archivoSeleccionado = string.Empty;
        xmlFirmadoContent = string.Empty;
        esReemplazo = false;
        StateHasChanged();
    }



    private void LimpiarBusqueda()
    {
        terminoBusqueda = string.Empty;
        facturasPaginadas = new();
        StateHasChanged();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            archivoSeleccionado = file.Name;

            if (!file.Name.EndsWith(".xml", StringComparison.OrdinalIgnoreCase))
            {
                MostrarMensaje("El archivo debe tener extensión .xml", false);
                archivoSeleccionado = string.Empty;
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            xmlFirmadoContent = await reader.ReadToEndAsync();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"Error al leer el archivo: {ex.Message}", false);
            archivoSeleccionado = string.Empty;
            xmlFirmadoContent = string.Empty;
        }
    }

    private async Task SubirXmlFirmado()
    {
        try
        {
            procesando = true;
            StateHasChanged();

            if (esReemplazo)
            {
                var (success, message) = await FacturacionService.ReemplazarXmlFirmadoAsync(facturaSeleccionadaId, xmlFirmadoContent);

                if (success)
                {
                    MostrarMensaje($"✅ {message}", true);
                    CerrarModal();
                    await CargarFacturas();
                }
                else
                {
                    MostrarMensaje($"❌ {message}", false);
                }
            }
            else
            {
                await FacturacionService.SubirXmlFirmadoAsync(facturaSeleccionadaId, xmlFirmadoContent);
                MostrarMensaje("✅ XML firmado subido correctamente", true);
                CerrarModal();
                await CargarFacturas();
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje($"❌ Error: {ex.Message}", false);
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    private async Task EnviarAlSri(int idFactura)
    {
        try
        {
            procesando = true;
            StateHasChanged();

            var (success, message) = await FacturacionService.EnviarAlSriAsync(idFactura);

            MostrarMensaje(success ? $"✅ {message}" : $"❌ {message}", success);
            await CargarFacturas();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"❌ Error: {ex.Message}", false);
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    private async Task ConsultarAutorizacion(int idFactura)
    {
        try
        {
            procesando = true;
            StateHasChanged();

            var (success, message) = await FacturacionService.ConsultarAutorizacionAsync(idFactura);

            MostrarMensaje(success ? $"✅ {message}" : $"⚠️ {message}", success);
            await CargarFacturas();
        }
        catch (Exception ex)
        {
            MostrarMensaje($"❌ Error: {ex.Message}", false);
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    private async Task DescargarYEnviarRide(int idFactura)
    {
        try
        {
            procesando = true;
            StateHasChanged();

            var pdfBytes = await FacturacionService.GenerarYEnviarRideAsync(idFactura);

            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("downloadFile",
            $"Factura_{idFactura}.pdf",
            "application/pdf",
            base64);

            MostrarMensaje("✅ PDF generado y enviado por correo electrónico", true);
        }
        catch (Exception ex)
        {
            MostrarMensaje($"❌ Error: {ex.Message}", false);
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    private void MostrarMensaje(string texto, bool esExito)
    {
        if (esExito)
        {
            mensajeExito = texto;
            mensajeError = string.Empty;
        }
        else
        {
            mensajeError = texto;
            mensajeExito = string.Empty;
        }

        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            mensajeExito = string.Empty;
            mensajeError = string.Empty;
            await InvokeAsync(StateHasChanged);
        });
    }
}