@typeparam TItem

<div class="d-flex justify-content-between align-items-center mt-3 pagination-container">
    <div class="text-muted">
        Mostrando <strong>@ItemsEnPaginaActual</strong> de <strong>@TotalItems</strong> registros
    </div>

    <nav aria-label="Paginación">
        <ul class="pagination mb-0">
            <li class="page-item @(PaginaActual == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="IrAPrimeraPagina" disabled="@(PaginaActual == 1)">
                    <i class="bi bi-chevron-double-left"></i>
                </button>
            </li>
            <li class="page-item @(PaginaActual == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="IrAPaginaAnterior" disabled="@(PaginaActual == 1)">
                    <i class="bi bi-chevron-left"></i> Anterior
                </button>
            </li>

            <li class="page-item active">
                <span class="page-link">
                    Página @PaginaActual de @TotalPaginas
                </span>
            </li>

            <li class="page-item @(PaginaActual == TotalPaginas ? "disabled" : "")">
                <button class="page-link" @onclick="IrAPaginaSiguiente" disabled="@(PaginaActual == TotalPaginas)">
                    Siguiente <i class="bi bi-chevron-right"></i>
                </button>
            </li>
            <li class="page-item @(PaginaActual == TotalPaginas ? "disabled" : "")">
                <button class="page-link" @onclick="IrAUltimaPagina" disabled="@(PaginaActual == TotalPaginas)">
                    <i class="bi bi-chevron-double-right"></i>
                </button>
            </li>
        </ul>
    </nav>
</div>

@code {
    [Parameter] public List<TItem> TodosLosItems { get; set; } = new();
    [Parameter] public int ItemsPorPagina { get; set; } = 8;
    [Parameter] public EventCallback<List<TItem>> OnCambioPagina { get; set; }

    private int PaginaActual { get; set; } = 1;
    private int _ultimoConteo = 0;

    private int TotalPaginas => TodosLosItems.Count > 0
    ? (int)Math.Ceiling((double)TodosLosItems.Count / ItemsPorPagina)
    : 1;

    private int TotalItems => TodosLosItems.Count;

    private int ItemsEnPaginaActual => ItemsPaginados.Count;

    private List<TItem> ItemsPaginados
    {
        get
        {
            if (TodosLosItems == null || TodosLosItems.Count == 0)
                return new List<TItem>();

            var itemsParaSaltar = (PaginaActual - 1) * ItemsPorPagina;

            return TodosLosItems
            .Skip(itemsParaSaltar)
            .Take(ItemsPorPagina)
            .ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TodosLosItems.Count != _ultimoConteo)
        {
            _ultimoConteo = TodosLosItems.Count;
            PaginaActual = 1;
            await NotificarCambio();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && TodosLosItems.Count > 0)
        {
            await NotificarCambio();
        }
    }

    private async Task IrAPaginaSiguiente()
    {
        if (PaginaActual < TotalPaginas)
        {
            PaginaActual++;
            await NotificarCambio();
        }
    }

    private async Task IrAPaginaAnterior()
    {
        if (PaginaActual > 1)
        {
            PaginaActual--;
            await NotificarCambio();
        }
    }

    private async Task IrAPrimeraPagina()
    {
        PaginaActual = 1;
        await NotificarCambio();
    }

    private async Task IrAUltimaPagina()
    {
        PaginaActual = TotalPaginas;
        await NotificarCambio();
    }

    private async Task NotificarCambio()
    {
        await OnCambioPagina.InvokeAsync(ItemsPaginados);
    }
}