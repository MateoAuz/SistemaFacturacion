@* Pages/Shared/MainLayout.razor *@
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav

<!-- Contenedor general con sidebar fijo y área de contenido -->
<div class="sidebar-container">
    <!-- Sidebar -->
    <div class="sidebar shadow-sm">
        <!-- Encabezado del sistema -->
        <div class="sidebar-header text-center py-3 border-bottom">
            <h5 class="text-white mb-0">
                <i class="bi bi-building me-2"></i>Mi Sistema
            </h5>
        </div>
        
        <!-- Navegación lateral -->
        <nav class="sidebar-nav mt-3">
            <a href="/dashboard" class="nav-item @GetNavItemClass("/dashboard")">
                <i class="bi bi-speedometer2 me-2"></i>
                <span>Dashboard</span>
            </a>
            
            <a href="/clientes" class="nav-item @GetNavItemClass("/clientes")">
                <i class="bi bi-people-fill me-2"></i>
                <span>Clientes</span>
            </a>
            
            <a href="/productos" class="nav-item @GetNavItemClass("/productos")">
                <i class="bi bi-box-seam me-2"></i>
                <span>Productos</span>
            </a>
            
            <a href="/ventas" class="nav-item @GetNavItemClass("/ventas")">
                <i class="bi bi-cart-check me-2"></i>
                <span>Ventas</span>
            </a>
            
            <a href="/reportes" class="nav-item @GetNavItemClass("/reportes")">
                <i class="bi bi-graph-up me-2"></i>
                <span>Reportes</span>
            </a>
        </nav>

        <!-- Pie del sidebar -->
        <div class="sidebar-footer border-top mt-auto py-3 text-center">
            <button class="btn btn-outline-light w-75" @onclick="ConfirmarLogout">
                <i class="bi bi-box-arrow-right me-2"></i>
                Cerrar Sesión
            </button>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="main-content-with-sidebar p-4">
        @Body
    </div>
</div>

@code {
    private bool isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            isInitialized = true;
            // Inicialización JS opcional
        }
    }

    private string GetNavItemClass(string url)
    {
        var currentUri = Nav.Uri;
        return currentUri.Contains(url) ? "active" : "";
    }

    private async Task ConfirmarLogout()
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Está seguro que desea cerrar sesión?");
        if (confirmado)
        {
            Nav.NavigateTo("/logout");
        }
    }
}
