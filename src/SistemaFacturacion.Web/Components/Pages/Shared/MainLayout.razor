@* Pages/Shared/MainLayout.razor *@
@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="sidebar-container">
    <div class="sidebar">
        <div class="sidebar-header">
            <h5><i class="bi bi-building"></i> Mi Sistema</h5>
        </div>
        
        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-item @GetNavItemClass("/dashboard")">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </a>
            
            <a href="/clientes" class="nav-item @GetNavItemClass("/clientes")">
                <i class="bi bi-people-fill"></i>
                <span>Clientes</span>
            </a>
            
            <a href="/productos" class="nav-item @GetNavItemClass("/productos")">
                <i class="bi bi-box-seam"></i>
                <span>Productos</span>
            </a>
            
            <a href="/ventas" class="nav-item @GetNavItemClass("/ventas")">
                <i class="bi bi-cart-check"></i>
                <span>Ventas</span>
            </a>
            
            <a href="/reportes" class="nav-item @GetNavItemClass("/reportes")">
                <i class="bi bi-graph-up"></i>
                <span>Reportes</span>
            </a>
        </nav>
        
        <div class="sidebar-footer">
            <button class="nav-item logout btn btn-link" @onclick="ConfirmarLogout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Cerrar Sesión</span>
            </button>
        </div>
    </div>

    <div class="main-content-with-sidebar">
        @Body
    </div>
</div>

@code {
    [Inject] 
    private NavigationManager Nav { get; set; } = default!;

    private bool isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isInitialized)
        {
            isInitialized = true;
            // Cualquier inicialización que necesite JS iría aquí
        }
    }

    private string GetNavItemClass(string url)
    {
        var currentUri = Nav.Uri;
        return currentUri.Contains(url) ? "active" : "";
    }

    private async Task ConfirmarLogout()
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Está seguro que desea cerrar sesión?");
        
        if (confirmado)
        {
            Nav.NavigateTo("/logout");
        }
    }
}