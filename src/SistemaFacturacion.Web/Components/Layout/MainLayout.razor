@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="sidebar-container">
    <div class="sidebar">
        <div class="sidebar-header">
            <h5><i class="bi bi-building"></i> PetMarket EC</h5>
        </div>

        <nav class="sidebar-nav">
            <a href="/dashboard" class="nav-item @GetNavItemClass("/dashboard")">
                <i class="bi bi-speedometer2"></i>
                <span>Principal</span>
            </a>

            <a href="/clientes" class="nav-item @GetNavItemClass("/clientes")">
                <i class="bi bi-people-fill"></i>
                <span>Clientes</span>
            </a>

            <a href="/productos" class="nav-item @GetNavItemClass("/productos")">
                <i class="bi bi-box-seam"></i>
                <span>Productos</span>
            </a>

            <a href="/ventas" class="nav-item @GetNavItemClass("/ventas")">
                <i class="bi bi-cart-check"></i>
                <span>Ventas</span>
            </a>

            <a href="/generacion" class="nav-item @GetNavItemClass("/generacion")">
                <i class="bi bi-receipt"></i>
                <span>Generacion</span>
            </a>

            <a href="/facturacion" class="nav-item @GetNavItemClass("/facturacion")">
                <i class="bi bi-file-earmark-text"></i>
                <span>Facturación Electrónica</span>
            </a>

            @* ✅ SIEMPRE renderizar, controlar visibilidad con JS *@
            <a href="/configuracion" class="nav-item @GetNavItemClass("/configuracion")" id="menu-config">
                <i class="bi bi-gear-fill me-2"></i>
                <span>Configuración</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <a href="/logout" class="nav-item logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Cerrar Sesión</span>
            </a>
        </div>
    </div>

    <div class="main-content-with-sidebar">
        @Body
    </div>
</div>

@code {
    private string GetNavItemClass(string url)
    {
        var currentUri = Nav.Uri;
        return currentUri.Contains(url) ? "active" : "";
    }
}
